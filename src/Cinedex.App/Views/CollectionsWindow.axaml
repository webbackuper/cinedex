<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.CollectionsWindow"
        x:DataType="vm:CollectionsViewModel"
        Title="Collections"
        Width="1180" Height="780" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <!-- Barre du bas : message, mention TMDb, fermeture -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="{StaticResource Above3}">
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource CinedexAccent}" FontWeight="SemiBold" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
        <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="{StaticResource FontSmall}" Margin="{StaticResource Inline4}"
                   Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
        <Button Classes="tool" Content="Interrompre" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="320,16,*">
      <!-- Liste des collections -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space2}" Margin="{StaticResource Below3}">
          <Border Classes="card" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Inline3}">
            <DockPanel>
              <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
              <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Chercher une collection" BorderThickness="0" Background="Transparent" Margin="{StaticResource Before1}" />
            </DockPanel>
          </Border>
          <CheckBox Content="Seulement les collections incomplètes" IsChecked="{Binding OnlyIncomplete}" />
          <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="{StaticResource FontSmall}" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="tool" HorizontalAlignment="Stretch" Margin="{StaticResource Above3}" Command="{Binding SyncCommand}"
                ToolTip.Tip="Retrouve sur TMDb les collections créées à la main (par leur nom), puis télécharge la présentation, la liste des films, l'affiche et le décor des collections qui ne les ont pas encore">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <controls:Icon Kind="cloud" Width="16" Height="16" />
            <TextBlock Text="Tout compléter depuis TMDb" />
          </StackPanel>
        </Button>
        <Panel>
          <TextBlock Text="Aucune collection pour l'instant. Les sagas sont créées à l'import des films liés à TMDb, ou à la main dans la fiche d'un film (onglet Classement)."
                     Classes="muted" TextWrapping="Wrap" Margin="{StaticResource Inset1x2}" IsVisible="{Binding !HasCollections}" />
          <ListBox ItemsSource="{Binding Collections}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CollectionRow">
                <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource Inset1}">
                  <Border Width="40" Height="60" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                    <Panel>
                      <controls:Icon Kind="collection" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                      <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="{StaticResource Edges3_0_1_0}" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="{StaticResource FontSmall}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>

      <!-- Fiche de la collection choisie -->
      <DockPanel Grid.Column="2" IsVisible="{Binding HasDetail}">
        <!-- Décor, affiche et nom -->
        <Border DockPanel.Dock="Top" Height="230" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
          <Panel>
            <Image Source="{Binding BackdropPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=1280}" Stretch="UniformToFill" />
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0.25" Color="{StaticResource ScrimClear}" />
                  <GradientStop Offset="1" Color="{StaticResource ScrimBottom}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource Inset4}" VerticalAlignment="Bottom">
              <Border Width="100" Height="150" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                <Panel>
                  <controls:Icon Kind="collection" Width="32" Height="32" Foreground="{DynamicResource CinedexMuted}" />
                  <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=200}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="{StaticResource Before4}" VerticalAlignment="Bottom" Spacing="{StaticResource Space1}">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontPage}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource OnImageTitleBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Panel>
        </Border>

        <!-- Actions sur la collection -->
        <WrapPanel DockPanel.Dock="Top" Margin="{StaticResource Above3}">
          <Button Classes="tool" Margin="{StaticResource Trail2}" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Relit la présentation et la liste des films sur TMDb, et télécharge à nouveau l'affiche et le décor">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="sync" Width="16" Height="16" /><TextBlock Text="Actualiser depuis TMDb" /></StackPanel>
          </Button>
          <Button Classes="tool" Margin="{StaticResource Trail2}" Click="OnOpenTmdb" IsVisible="{Binding TmdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="Voir sur TMDb ↗" /></StackPanel>
          </Button>
          <Button Classes="tool" Margin="{StaticResource Trail2}" Content="Renommer…" IsEnabled="{Binding !IsBusy}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="{StaticResource Space2}" Width="320">
                  <TextBlock Text="Nom de la collection" FontWeight="SemiBold" />
                  <TextBox Text="{Binding EditedName}" />
                  <Button Classes="primary" HorizontalAlignment="Right" Content="Renommer" Command="{Binding RenameCommand}" Click="OnRenamed" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="tool" Margin="{StaticResource Trail2}" Content="Supprimer la collection…" Click="OnDelete"
                  ToolTip.Tip="Supprime la collection ; ses films restent dans le catalogue" />
        </WrapPanel>

        <!-- Présentation -->
        <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Overview}" TextWrapping="Wrap" LineHeight="20" Margin="{StaticResource Edges0_1_0_3}" MaxHeight="110"
                             IsVisible="{Binding Overview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Films de la saga -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Films}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CollectionFilm">
                <Button Classes="tool" Width="148" Margin="{StaticResource Trail3}" Padding="{StaticResource Inset2}" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Click="OnFilmClick"
                        ToolTip.Tip="{Binding Subtitle}">
                  <StackPanel Spacing="{StaticResource Space2}">
                    <Border Width="132" Height="198" CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                      <Panel>
                        <controls:Icon Kind="film" Width="28" Height="28" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                        <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=264}" Stretch="UniformToFill" />
                        <Border Background="{DynamicResource CinedexPosterBack}" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.5" />
                        </Border>
                        <Border IsVisible="{Binding !IsOwned}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="{StaticResource Inset2}" Padding="{StaticResource Inset2x1}" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource BadgeScrimBrush}">
                          <TextBlock Text="Manquant" FontSize="{StaticResource FontSmall}" Foreground="White" />
                        </Border>
                        <Border IsVisible="{Binding IsOwned}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="{StaticResource Inset2}" Padding="{StaticResource Inset1}" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource CinedexAccent}">
                          <controls:Icon Kind="check" Width="12" Height="12" Foreground="White" />
                        </Border>
                      </Panel>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
