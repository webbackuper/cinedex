<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        x:Class="Bobine.App.Views.AdvancedSearchWindow"
        x:DataType="vm:AdvancedSearchViewModel"
        Title="Recherche avancée"
        Width="720" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock VerticalAlignment="Center" Opacity="0.6" Margin="0,0,16,0" Text="Les critères renseignés se cumulent." />
      <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="Rechercher" IsDefault="True" Click="OnSearch" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="150,*,8,180" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="Grid > :is(Control)">
              <Setter Property="Margin" Value="0,4" />
            </Style>
            <Style Selector="Grid > TextBlock">
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Row="0" Text="Personne" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PersonName}" PlaceholderText="Nom ou partie du nom" />
          <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
          <TextBlock Grid.Row="1" Text="Personnage" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Character}" />
          <TextBlock Grid.Row="2" Text="Années" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="90" Text="{Binding YearFrom}" PlaceholderText="de" />
            <TextBox Width="90" Text="{Binding YearTo}" PlaceholderText="à" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="Notes minimales" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="90" Text="{Binding UserRatingMin}" PlaceholderText="la mienne" />
            <TextBox Width="90" Text="{Binding SourceRatingMin}" PlaceholderText="TMDb" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Tag" />
          <ComboBox Grid.Row="4" Grid.Column="1" MinWidth="240" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" />
          <TextBlock Grid.Row="5" Text="Groupe" />
          <ComboBox Grid.Row="5" Grid.Column="1" MinWidth="240" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" />
          <TextBlock Grid.Row="6" Text="Collection" />
          <ComboBox Grid.Row="6" Grid.Column="1" MinWidth="240" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" />
          <TextBlock Grid.Row="7" Text="Emplacement, emprunteur" />
          <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="180" Text="{Binding Location}" PlaceholderText="Emplacement" />
            <TextBox Width="180" Text="{Binding Borrower}" PlaceholderText="Prêté à" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Genres : titres ayant" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding GenreModes}" SelectedItem="{Binding SelectedGenreMode}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Genres}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GenreChoice">
              <CheckBox Width="200" Content="{Binding Genre.Label}" IsChecked="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
