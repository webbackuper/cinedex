<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        xmlns:people="using:Bobine.Core.People"
        xmlns:views="using:Bobine.App.Views"
        xmlns:controls="using:Bobine.App.Controls"
        x:Class="Bobine.App.Views.PersonWindow"
        x:DataType="vm:PersonViewModel"
        Title="{Binding Name}"
        Width="860" Height="640" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="300,*" Margin="20">
    <!-- Identité -->
    <ScrollViewer Grid.Column="0" Margin="0,0,20,0">
      <StackPanel Spacing="12">
        <Border Width="220" Height="300" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource BobinePosterBack}" HorizontalAlignment="Left">
          <Panel>
            <controls:Icon Kind="about" Width="48" Height="48" Foreground="{DynamicResource BobineMuted}" />
            <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=440}" Stretch="UniformToFill" />
          </Panel>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding KnownFor}" Classes="muted" IsVisible="{Binding KnownFor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Dates}" Classes="muted" TextWrapping="Wrap" FontSize="12.5" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="tool" Click="OnOpenTmdb" IsVisible="{Binding TmdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche TMDb">
            <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="TMDb" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnOpenImdb" IsVisible="{Binding ImdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche IMDb">
            <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="IMDb" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Text="Chargement de la fiche TMDb..." Classes="muted" IsVisible="{Binding IsLoading}" />
        <SelectableTextBlock Text="{Binding Biography}" TextWrapping="Wrap" LineHeight="20"
                             IsVisible="{Binding Biography, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Ses titres dans le catalogue -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="4,0,0,10">
        <TextBlock Text="Dans le catalogue" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Count}" Classes="muted" FontSize="12.5" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Titles}" DoubleTapped="OnTitleChosen" Tapped="OnTitleChosen">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="people:PersonCredit">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2" ToolTip.Tip="Afficher ce titre dans le catalogue">
              <Border Width="40" Height="60" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource BobinePosterBack}">
                <Panel>
                  <controls:Icon Kind="default" Width="18" Height="18" Foreground="{DynamicResource BobineMuted}" Opacity="0.6" />
                  <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12.5" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource BobineMuted}" RenderTransform="rotate(-90deg)" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
