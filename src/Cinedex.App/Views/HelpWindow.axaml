<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:services="using:Cinedex.App.Services"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="{Binding Title}"
        Width="1040" Height="760" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="280,*">
    <!-- Sommaire et recherche -->
    <Border Background="{DynamicResource CinedexSidebar}" BorderBrush="{DynamicResource CinedexBorder}" BorderThickness="{StaticResource HairlineEnd}">
      <DockPanel Margin="{StaticResource WindowPadding}">
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space3}" Margin="{StaticResource Below3}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
            <Image Source="/Assets/cinedex.png" Width="28" Height="28" />
            <TextBlock Text="{x:Static vm:HelpViewModel.VersionText}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Rechercher dans l'aide…" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="services:HelpSection">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Rubrique -->
    <ScrollViewer Grid.Column="1" x:Name="Reader">
      <StackPanel Margin="{StaticResource Edges8_6_8_8}" Spacing="{StaticResource Space3}" MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding SelectedSection}" x:DataType="services:HelpSection">
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontPage}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{StaticResource Below2}" />
        <ItemsControl ItemsSource="{Binding Blocks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:HelpBlock">
              <Panel Margin="{StaticResource Block1}">
                <controls:RichLine Markup="{Binding Text}" TextWrapping="Wrap" LineHeight="22" FontSize="{StaticResource FontBody}" IsVisible="{Binding IsParagraph}" />
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding IsBullet}">
                  <TextBlock Text="•" Foreground="{DynamicResource CinedexAccent}" FontSize="{StaticResource FontBody}" />
                  <controls:RichLine Grid.Column="1" Markup="{Binding Text}" TextWrapping="Wrap" LineHeight="22" FontSize="{StaticResource FontBody}" />
                </Grid>
                <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" Margin="{StaticResource Above3}"
                           IsVisible="{Binding IsSubheading}" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
