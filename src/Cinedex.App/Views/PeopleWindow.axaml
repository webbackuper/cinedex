<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:people="using:Cinedex.Core.People"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.PeopleWindow"
        x:DataType="vm:PeopleBrowserViewModel"
        Title="{Binding WindowTitle}"
        Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <Border DockPanel.Dock="Top" Classes="card" CornerRadius="10" Padding="10,0" Margin="0,0,0,12">
      <DockPanel>
        <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}" BorderThickness="0" Background="Transparent" Margin="4,0,0,0" />
      </DockPanel>
    </Border>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <StackPanel Spacing="4">
        <Button Classes="tool" HorizontalAlignment="Left" Command="{Binding DownloadDetailsCommand}"
                ToolTip.Tip="Biographie, dates et photo depuis TMDb pour les personnes listées qui ne les ont pas encore">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Kind="cloud" Width="16" Height="16" /><TextBlock Text="Télécharger les fiches manquantes" /></StackPanel>
        </Button>
        <TextBlock Text="{Binding Message}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="tool" Content="Interrompre" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
    <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding Selected}" Tapped="OnPersonChosen">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="people:PersonSummary">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
            <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
              <Panel>
                <controls:Icon Kind="about" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
