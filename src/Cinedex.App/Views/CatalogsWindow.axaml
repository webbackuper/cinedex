<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:data="using:Cinedex.Data"
        x:Class="Cinedex.App.Views.CatalogsWindow"
        x:DataType="vm:CatalogsViewModel"
        Title="Catalogues"
        Width="620" Height="480" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Chaque catalogue est une base indépendante, avec ses titres, ses images et ses réglages. Un nouveau catalogue reprend les réglages du catalogue ouvert." />
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding Current, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Catalogue ouvert : {0}'}" />

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBox Text="{Binding NameText}" PlaceholderText="Nom (nouveau catalogue ou nouveau nom)" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.8"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Créer et ouvrir" Command="{Binding CreateCommand}" />
        <Button Content="Renommer" Command="{Binding RenameCommand}" />
        <Button Content="Retirer" Command="{Binding RemoveCommand}" ToolTip.Tip="Le catalogue est déplacé dans les sauvegardes, pas effacé" />
        <Button Content="Ouvrir" Command="{Binding OpenCommand}" />
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </StackPanel>

    <ListBox ItemsSource="{Binding Catalogs}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="data:CatalogEntry">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding LastModifiedUtc, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='modifié le {0:d}'}" Opacity="0.6" FontSize="{StaticResource FontSmall}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
