<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        x:Class="Bobine.App.Views.BulkEditWindow"
        x:DataType="vm:BulkEditViewModel"
        Title="Modification groupée"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{Binding Header}" TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock Text="Case grisée : inchangé. Cochée : oui. Décochée : non." Opacity="0.7" FontSize="12" />
    <CheckBox IsThreeState="True" IsChecked="{Binding IsOwned}" Content="Possédé (non : liste de souhaits)" />
    <CheckBox IsThreeState="True" IsChecked="{Binding IsSeen}" Content="Vu" />
    <CheckBox IsThreeState="True" IsChecked="{Binding IsFavorite}" Content="Favori" />
    <CheckBox IsThreeState="True" IsChecked="{Binding IsShortlisted}" Content="Liste courte" />
    <CheckBox IsThreeState="True" IsChecked="{Binding IsLocked}" Content="Verrouillé contre les mises à jour Internet" />
    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
      <Grid.Styles>
        <Style Selector="Grid > :is(Control)">
          <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="Grid > TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Text="Support" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedium}" />
      <TextBlock Grid.Row="1" Text="Collection" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" />
      <TextBlock Grid.Row="2" Text="Emplacement" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Location}" PlaceholderText="(ne pas modifier)" />
      <TextBlock Grid.Row="3" Text="Ajouter des tags" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AddTags}" PlaceholderText="séparés par des virgules" />
      <TextBlock Grid.Row="4" Text="Retirer des tags" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RemoveTags}" />
      <TextBlock Grid.Row="5" Text="Ajouter à des groupes" />
      <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AddGroups}" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="Appliquer" IsDefault="True" Click="OnApply" />
    </StackPanel>
  </StackPanel>
</Window>
