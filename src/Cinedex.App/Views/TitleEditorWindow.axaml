<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:people="using:Cinedex.Core.People"
        x:Class="Cinedex.App.Views.TitleEditorWindow"
        x:DataType="vm:TitleEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="860" Height="700" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="{StaticResource WindowPadding}">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
        <Button Classes="primary" Content="Enregistrer" IsDefault="True" Click="OnSave" />
      </StackPanel>
    </StackPanel>

    <TabControl>
      <TabItem Header="Fiche">
        <ScrollViewer>
          <Grid ColumnDefinitions="*,Auto" Margin="0,8">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <Grid.Styles>
                <Style Selector="Grid > :is(Control)">
                  <Setter Property="Margin" Value="0,4" />
                </Style>
              </Grid.Styles>
              <TextBlock Classes="label" Grid.Row="0" Text="Type" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
              <TextBlock Classes="label" Grid.Row="1" Text="Titre" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" />
              <TextBlock Classes="label" Grid.Row="2" Text="Titre original" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OriginalTitle}" />
              <TextBlock Classes="label" Grid.Row="3" Text="Autre titre" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AlternativeTitle}" />
              <TextBlock Classes="label" Grid.Row="4" Text="Année" />
              <TextBox Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Year}" />
              <TextBlock Classes="label" Grid.Row="5" Text="Durée (minutes)" />
              <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBox Width="100" Text="{Binding Runtime}" />
                <TextBlock Text="{Binding RuntimeText}" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Classes="label" Grid.Row="6" Text="Accroche" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Tagline}" />
              <TextBlock Classes="label" Grid.Row="7" Text="Synopsis" VerticalAlignment="Top" />
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Overview}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
              <TextBlock Classes="label" Grid.Row="8" Text="Certification" />
              <TextBox Grid.Row="8" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding Certification}" />
              <TextBlock Classes="label" Grid.Row="9" Text="Pays" />
              <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Countries}" PlaceholderText="FR, US" />
              <TextBlock Classes="label" Grid.Row="10" Text="Langues parlées" />
              <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SpokenLanguages}" PlaceholderText="fr, en" />
              <TextBlock Classes="label" Grid.Row="11" Text="Studio" />
              <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Studio}" />
              <TextBlock Classes="label" Grid.Row="12" Text="Identifiant IMDb" />
              <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <TextBox Width="160" Text="{Binding ImdbId}" PlaceholderText="tt1234567" />
                <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center" Opacity="0.7" />
              </StackPanel>
              <TextBlock Classes="label" Grid.Row="13" Text="Lien web" />
              <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding WebLink}" PlaceholderText="https://" />
              <TextBlock Classes="label" Grid.Row="14" Text="Bande-annonce" />
              <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding TrailerUrl}" PlaceholderText="https://" />
            </Grid>
            <Border Grid.Column="1" Width="150" Height="225" Margin="16,4,0,0" VerticalAlignment="Top" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True"
                    Background="{DynamicResource CinedexSurfaceAlt}"
                    IsVisible="{Binding PosterPath, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=300}" Stretch="UniformToFill" />
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Notes">
        <ScrollViewer>
          <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8">
            <Grid.Styles>
              <Style Selector="Grid > :is(Control)">
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </Grid.Styles>
            <TextBlock Classes="label" Grid.Row="0" Text="Ma note (0 à 10)" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding UserRating}" />
            <TextBlock Classes="label" Grid.Row="1" Text="Note TMDb (0 à 10)" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding TmdbRating}" />
            <TextBlock Classes="label" Grid.Row="2" Text="Note IMDb (0 à 10)" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding ImdbRating}" />
            <TextBlock Classes="label" Grid.Row="3" Text="Votes IMDb" />
            <TextBox Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" Text="{Binding ImdbVotes}" />
            <TextBlock Classes="label" Grid.Row="4" Text="Rotten Tomatoes (%)" />
            <TextBox Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Tomatometer}" />
            <TextBlock Classes="label" Grid.Row="5" Text="Metascore (0 à 100)" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Metascore}" />
            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Les notes TMDb, IMDb, Rotten Tomatoes et Metacritic sont remplacées à la prochaine mise à jour depuis Internet, sauf si la fiche est verrouillée." />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Distribution">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8">
            <TextBlock Text="Aucun acteur enregistré : lancez une mise à jour depuis TMDb pour récupérer la distribution." Opacity="0.7" TextWrapping="Wrap"
                       IsVisible="{Binding !HasCast}" />
            <TextBlock Text="Réalisation" FontWeight="SemiBold" IsVisible="{Binding HasDirectors}" />
            <ItemsControl ItemsSource="{Binding Directors}" IsVisible="{Binding HasDirectors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="people:CastMember">
                  <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,3" Margin="0,1"
                          Click="OnOpenPerson" Cursor="Hand" ToolTip.Tip="{Binding Name, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Fiche de {0}'}">
                    <Grid ColumnDefinitions="40,*,*">
                      <Border Width="32" Height="40" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexSurfaceAlt}">
                        <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=64}" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Character}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Acteurs" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding HasCast}" />
            <ItemsControl ItemsSource="{Binding Cast}" IsVisible="{Binding HasCast}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="people:CastMember">
                  <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,3" Margin="0,1"
                          Click="OnOpenPerson" Cursor="Hand" ToolTip.Tip="{Binding Name, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Fiche de {0}'}">
                    <Grid ColumnDefinitions="40,*,*">
                      <Border Width="32" Height="40" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexSurfaceAlt}">
                        <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=64}" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Character}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Équipe" FontWeight="SemiBold" Margin="0,8,0,0"
                       IsVisible="{Binding CrewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <SelectableTextBlock Text="{Binding CrewText}" TextWrapping="Wrap" LineHeight="20"
                                 IsVisible="{Binding CrewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Fichier">
        <DockPanel Margin="0,8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Classes="tool" Content="Relire les infos techniques (MediaInfo)" Command="{Binding RefreshMediaCommand}"
                    IsVisible="{Binding CanRefreshMedia}" IsEnabled="{Binding !IsRefreshingMedia}" />
            <Button Classes="tool" Content="Ajouter une partie (CD2, part2…)" Click="OnAddPart"
                    IsVisible="{Binding CanAddFile}" IsEnabled="{Binding !IsRefreshingMedia}"
                    ToolTip.Tip="Rattacher un fichier de plus à ce film quand il est découpé en plusieurs fichiers" />
            <TextBlock Text="Lecture en cours…" VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding IsRefreshingMedia}" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="12">
              <Border Padding="12,10" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource CinedexSurfaceAlt}" IsVisible="{Binding HasFiles}">
                <StackPanel Spacing="6">
                  <TextBlock Text="MediaID : nom du disque où se trouve le fichier" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileVolumeRow">
                        <Grid ColumnDefinitions="200,*" Margin="0,3">
                          <TextBox Text="{Binding MediaId}" PlaceholderText="Nom du disque" ToolTip.Tip="Rempli au scan avec le nom du disque (Propriétés dans Windows)" />
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Header}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.75" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <SelectableTextBlock Text="{Binding MediaText}" TextWrapping="Wrap" LineHeight="21" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Exemplaire">
        <ScrollViewer>
          <StackPanel>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8">
            <Grid.Styles>
              <Style Selector="Grid > :is(Control)">
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </Grid.Styles>
            <TextBlock Classes="label" Grid.Row="0" Text="Numéro" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="100" Text="{Binding Number}" />
              <TextBox Width="160" Text="{Binding CustomNumber}" PlaceholderText="Numéro personnalisé" />
            </StackPanel>
            <TextBlock Classes="label" Grid.Row="1" Text="Support" />
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedium}" />
            <TextBlock Classes="label" Grid.Row="2" Text="Boîtier" />
            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" />
            <TextBlock Classes="label" Grid.Row="3" Text="Version" />
            <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
            <TextBlock Classes="label" Grid.Row="4" Text="Emplacement" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Location}" PlaceholderText="Étagère, boîte… (le chemin du fichier est dans l'onglet Fichier)" />
            <TextBlock Classes="label" Grid.Row="5" Text="Nombre de disques" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding DiscCount}" />
            <TextBlock Classes="label" Grid.Row="6" Text="EAN / UPC" />
            <TextBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Ean}" />
            <TextBlock Classes="label" Grid.Row="7" Text="Prix" />
            <TextBox Grid.Row="7" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Price}" />
            <CheckBox Grid.Row="8" Grid.Column="1" Content="3D" IsChecked="{Binding Is3D}" />
          </Grid>

          <!-- Prêt : enregistré aussitôt, indépendamment du bouton Enregistrer. -->
          <Border Margin="0,8,0,8" Padding="14,12" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource CinedexSurfaceAlt}"
                  IsVisible="{Binding $parent[Window].((vm:TitleEditorViewModel)DataContext).HasLoans}" DataContext="{Binding Loans}" x:DataType="vm:LoanEditorViewModel">
            <StackPanel Spacing="10">
              <TextBlock Text="Prêt" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" />
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" />

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsLoaned}">
                <AutoCompleteBox Width="240" Text="{Binding BorrowerText}" ItemsSource="{Binding Borrowers}"
                                 FilterMode="ContainsOrdinal" PlaceholderText="Emprunteur" />
                <CalendarDatePicker SelectedDate="{Binding LoanDate}" Width="150" />
                <Button Classes="outline" Content="Prêter" Command="{Binding LendCommand}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoaned}">
                <TextBlock Text="Rendu le" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding ReturnDate}" Width="150" />
                <Button Classes="outline" Content="Marquer comme rendu" Command="{Binding ReturnCommand}" />
              </StackPanel>

              <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock Text="Historique" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding HasHistory}" />
              <TextBlock Text="Aucun prêt enregistré pour ce titre." Opacity="0.7" IsVisible="{Binding !HasHistory}" />
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LoanLine">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="tool" Content="Effacer" Padding="8,2" ToolTip.Tip="Effacer cette ligne (saisie erronée)"
                              Command="{Binding $parent[ItemsControl].((vm:LoanEditorViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Genres">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Genres}" Margin="0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GenreChoice">
                <CheckBox Width="200" Content="{Binding Genre.Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Classement">
        <StackPanel Spacing="8" Margin="0,8">
          <TextBlock Text="Collection (saga, coffret)" />
          <ComboBox MinWidth="320" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" />
          <TextBlock Text="Tags, séparés par des virgules" Margin="0,8,0,0" />
          <TextBox Text="{Binding TagsText}" PlaceholderText="culte, huis clos, à revoir" />
          <TextBlock Text="Groupes personnels, séparés par des virgules" Margin="0,8,0,0" />
          <TextBox Text="{Binding GroupsText}" PlaceholderText="Soirée famille, Noël" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Statut">
        <StackPanel Spacing="8" Margin="0,8">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Vu" IsChecked="{Binding IsSeen}" />
            <TextBlock Text="{Binding SeenText}" VerticalAlignment="Center" Opacity="0.7" />
          </StackPanel>
          <CheckBox Content="Possédé (décoché : liste de souhaits)" IsChecked="{Binding IsOwned}" />
          <CheckBox Content="Favori" IsChecked="{Binding IsFavorite}" />
          <CheckBox Content="Liste courte" IsChecked="{Binding IsShortlisted}" />
          <CheckBox Content="Verrouillé : ne pas mettre à jour depuis Internet" IsChecked="{Binding IsLocked}" />
          <CheckBox Content="Contenu pour adultes" IsChecked="{Binding IsAdult}" />
          <TextBlock Text="Commentaires" Margin="0,8,0,0" />
          <TextBox Text="{Binding Comments}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
