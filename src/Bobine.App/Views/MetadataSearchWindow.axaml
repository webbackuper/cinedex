<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        x:Class="Bobine.App.Views.MetadataSearchWindow"
        x:DataType="vm:MetadataSearchViewModel"
        Title="Rechercher sur TMDb"
        Width="760" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Heat (1995), tt0113277, movie/949...">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Margin="8,0,0,0" Content="Rechercher" Command="{Binding SearchCommand}" />
      </Grid>
      <TextBlock Text="{Binding Message}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="11" Margin="0,0,16,0"
                 Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
      <Button Content="Annuler" IsCancel="True" Click="OnCancel" />
      <Button Content="Choisir" IsDefault="True" Click="OnChoose" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" DoubleTapped="OnChoose">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SearchRow">
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" />
            <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
