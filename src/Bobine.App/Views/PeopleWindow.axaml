<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        xmlns:people="using:Bobine.Core.People"
        xmlns:views="using:Bobine.App.Views"
        xmlns:controls="using:Bobine.App.Controls"
        x:Class="Bobine.App.Views.PeopleWindow"
        x:DataType="vm:PeopleBrowserViewModel"
        Title="Personnes du catalogue"
        Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <Border DockPanel.Dock="Top" Classes="card" CornerRadius="10" Padding="10,0" Margin="0,0,0,12">
      <DockPanel>
        <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource BobineMuted}" />
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Acteur, réalisateur, scénariste, compositeur…" BorderThickness="0" Background="Transparent" Margin="4,0,0,0" />
      </DockPanel>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
    </StackPanel>
    <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding Selected}" Tapped="OnPersonChosen">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="people:PersonSummary">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
            <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource BobinePosterBack}">
              <Panel>
                <controls:Icon Kind="about" Width="18" Height="18" Foreground="{DynamicResource BobineMuted}" />
                <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
