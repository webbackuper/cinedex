<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:titles="using:Cinedex.Core.Titles"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.RuleSearchWindow"
        x:DataType="vm:RuleSearchViewModel"
        Title="Recherche multicritère"
        Width="860" Height="560" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="{StaticResource Below3}">
      <TextBlock Text="Afficher les films qui respectent" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding MatchChoices}" SelectedItem="{Binding SelectedMatch}" MinWidth="260" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="{StaticResource Above3}">
      <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
        <Button Classes="tool" Content="Tout effacer" Command="{Binding ClearRulesCommand}" />
        <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
        <Button Classes="primary" Content="Rechercher" IsDefault="True" Click="OnSearch" />
      </StackPanel>
    </Grid>

    <ScrollViewer>
      <StackPanel Spacing="{StaticResource Space2}">
        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RuleRowViewModel">
              <Grid ColumnDefinitions="260,8,170,8,*,8,Auto" Margin="{StaticResource Block1}">
                <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" HorizontalAlignment="Stretch" MaxDropDownHeight="420">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="titles:SearchField">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Group, StringFormat='· {0}'}" Opacity="0.5" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="4" Text="{Binding Value}" PlaceholderText="{Binding Watermark}" IsVisible="{Binding IsTextValue}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsGenreValue}" MaxDropDownHeight="420" />
                <Button Grid.Column="6" Classes="tool" ToolTip.Tip="Retirer cette condition"
                        Command="{Binding $parent[Window].((vm:RuleSearchViewModel)DataContext).RemoveRuleCommand}" CommandParameter="{Binding}">
                  <controls:Icon Kind="close" Width="16" Height="16" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="tool" HorizontalAlignment="Left" Command="{Binding AddRuleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <controls:Icon Kind="add" Width="16" Height="16" />
            <TextBlock Text="Ajouter une condition" />
          </StackPanel>
        </Button>
        <TextBlock Margin="{StaticResource Above3}" Opacity="0.6" TextWrapping="Wrap"
                   Text="Exemple : Genre est Comédie, puis Note IMDb &gt; 7, puis Année ≥ 2000. Les textes ignorent les majuscules ; « contient » cherche une partie du texte." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
