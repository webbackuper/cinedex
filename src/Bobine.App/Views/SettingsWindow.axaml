<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        x:Class="Bobine.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Réglages"
        Width="680" Height="720" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="Source de données : TMDb" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Text="{Binding TokenState}" TextWrapping="Wrap" Opacity="0.8" />
    <TextBox Text="{Binding NewToken}" PasswordChar="•" PlaceholderText="Jeton d'accès en lecture (eyJ...)" />
    <Grid ColumnDefinitions="Auto,120,24,Auto,80" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" Text="Langue" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding Language}" PlaceholderText="fr-FR" />
      <TextBlock Grid.Column="3" Text="Pays des certifications" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="4" Text="{Binding Country}" PlaceholderText="FR" />
    </Grid>
    <TextBlock Text="Fichiers vidéo" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBox Text="{Binding MediaInfoPath}" PlaceholderText="Chemin de MediaInfo CLI, MediaInfo.exe (vide : dossier tools/MediaInfo de Bobine, puis PATH)" />
    <TextBox Text="{Binding FfprobePath}" PlaceholderText="Repli : chemin de ffprobe (facultatif)" />
    <TextBox Text="{Binding PlayerPath}" PlaceholderText="Lecteur externe (vide : lecteur par défaut du système)" />
    <TextBox Text="{Binding PlayerArgs}" PlaceholderText="Paramètres du lecteur, ex. --fullscreen %FILEPATH%" />
    <CheckBox Content="Marquer comme vu à la lecture depuis Bobine" IsChecked="{Binding MarkSeenOnPlay}" />
    <CheckBox Content="Au scan, ignorer le contenu entre ( ) et [ ] dans les noms de fichiers (par défaut)" IsChecked="{Binding IgnoreBracketed}" />
    <TextBlock Text="Fichiers .nfo (format Kodi)" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
    <CheckBox Content="Lire le .nfo au scan d'un dossier et compléter la fiche" IsChecked="{Binding NfoReadOnScan}" />
    <CheckBox Content="Créer ou compléter le .nfo après une mise à jour TMDb" IsChecked="{Binding NfoWriteAfterMetadata}" />
    <CheckBox Content="Remplacer les valeurs déjà présentes dans le .nfo (sinon seuls les champs manquants sont ajoutés)" IsChecked="{Binding NfoOverwrite}" />
    <CheckBox Content="Garder une copie .nfo.bak du fichier d'origine avant modification" IsChecked="{Binding NfoBackup}" />
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
               Text="Bobine utilise l'API TMDb. This product uses the TMDB API but is not endorsed or certified by TMDB. IMDb n'est utilisé que pour les identifiants et les liens." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Oublier le jeton" Click="OnForget" IsVisible="{Binding HasToken}" />
      <Button Content="Annuler" IsCancel="True" Click="OnCancel" />
      <Button Content="Enregistrer" IsDefault="True" Click="OnSave" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
