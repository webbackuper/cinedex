<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        xmlns:titles="using:Bobine.Core.Titles"
        xmlns:views="using:Bobine.App.Views"
        x:Class="Bobine.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Bobine"
        Width="1280" Height="760" MinWidth="800" MinHeight="480">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding ToggleSeenCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleFavoriteCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding PickRandomCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding PickRandomCommand}" />
    <KeyBinding Gesture="Alt+E" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding AdvancedSearchCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding AddFromTmdbCommand}" />
    <KeyBinding Gesture="Ctrl+U" Command="{Binding LinkToTmdbCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ImportFolderCommand}" />
  </Window.KeyBindings>

  <DockPanel Margin="16">
    <!-- Barre de recherche, filtre et tri -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Width="300" Margin="0,0,8,0" PlaceholderText="Rechercher (Ctrl+F)" Text="{Binding SearchText}" />
      <ComboBox Width="200" Margin="0,0,8,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" ToolTip.Tip="Filtre" />
      <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" ToolTip.Tip="Trier par" />
      <ToggleButton Margin="0,0,8,0" IsChecked="{Binding SortDescending}" Content="Ordre inverse" />
      <Button Margin="0,0,8,0" Content="Recherche avancée" Command="{Binding AdvancedSearchCommand}" ToolTip.Tip="Ctrl+Maj+F" />
      <Button Margin="0,0,8,0" Content="Tout afficher" Command="{Binding ClearSearchCommand}" ToolTip.Tip="Efface recherche, filtre et critères (Échap)" />
      <Button Margin="0,0,8,0" Content="Au hasard" Command="{Binding PickRandomCommand}" ToolTip.Tip="Un titre non vu au hasard (Ctrl+R)" />
      <Button Margin="0,0,8,0" Content="Tout mettre à jour (TMDb)" Command="{Binding UpdateAllFromTmdbCommand}" />
      <Button Margin="0,0,8,0" Content="Vérifier les fichiers" Command="{Binding CheckFilesCommand}" ToolTip.Tip="Repère les fichiers absents et retrouve ceux qui ont été déplacés" />
      <Button Content="Réglages" Command="{Binding OpenSettingsCommand}" />
    </WrapPanel>

    <!-- Actions -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox x:Name="NewTitleBox" Width="300" Margin="0,0,8,0" PlaceholderText="Nouveau titre, ex. Heat (1995)" Text="{Binding NewTitleText}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Margin="0,0,8,0" Content="Ajouter" Command="{Binding AddCommand}" ToolTip.Tip="Ajout manuel" />
      <Button Margin="0,0,8,0" Content="Ajouter depuis TMDb" Command="{Binding AddFromTmdbCommand}" ToolTip.Tip="Recherche le titre saisi sur TMDb (Ctrl+T)" />
      <Button Margin="0,0,16,0" Content="Ajouter depuis le disque" Command="{Binding ImportFolderCommand}" ToolTip.Tip="Analyse un dossier de fichiers vidéo (Ctrl+H)" />
      <Button Margin="0,0,8,0" Content="Lire" Command="{Binding PlayCommand}" ToolTip.Tip="Ctrl+P" />
      <Button Margin="0,0,8,0" Content="Dossier" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Ouvre le dossier du fichier (Ctrl+O)" />
      <Button Margin="0,0,8,0" Content="Modifier" Command="{Binding EditCommand}" ToolTip.Tip="Alt+E ou double-clic" />
      <Button Margin="0,0,8,0" Content="Vu / non vu" Command="{Binding ToggleSeenCommand}" ToolTip.Tip="Ctrl+S" />
      <Button Margin="0,0,8,0" Content="Favori" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Ctrl+D" />
      <Button Margin="0,0,8,0" Content="Lier / mettre à jour (TMDb)" Command="{Binding LinkToTmdbCommand}" ToolTip.Tip="Ctrl+U" />
      <Button Content="Supprimer" Command="{Binding DeleteCommand}" ToolTip.Tip="Suppr" />
    </WrapPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Status}" Opacity="0.8" />
      <TextBlock Grid.Column="1" Text="{Binding DataLocation}" Opacity="0.6" FontSize="12" />
    </Grid>

    <Grid ColumnDefinitions="*,16,380">
      <!-- Liste -->
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="56,*,64,150,56,40,40,120" Margin="12,0,12,4" Opacity="0.7">
          <TextBlock Grid.Column="0" Text="N°" />
          <TextBlock Grid.Column="1" Text="Titre" />
          <TextBlock Grid.Column="2" Text="Année" />
          <TextBlock Grid.Column="3" Text="Support" />
          <TextBlock Grid.Column="4" Text="Note" />
          <TextBlock Grid.Column="5" Text="Vu" />
          <TextBlock Grid.Column="6" Text="Fav." />
          <TextBlock Grid.Column="7" Text="Prêté à" />
        </Grid>
        <ListBox x:Name="TitleList" ItemsSource="{Binding Titles}" SelectedItems="{Binding SelectedTitles}" SelectionMode="Multiple"
                 DoubleTapped="OnListDoubleTapped">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="titles:TitleSummary">
              <Grid ColumnDefinitions="56,*,64,150,56,40,40,120">
                <TextBlock Grid.Column="0" Text="{Binding Number}" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Year}" />
                <TextBlock Grid.Column="3" Text="{Binding Medium}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                <TextBlock Grid.Column="4" Text="{Binding UserRating}" />
                <TextBlock Grid.Column="5" Text="✓" IsVisible="{Binding IsSeen}" />
                <TextBlock Grid.Column="6" Text="★" IsVisible="{Binding IsFavorite}" />
                <TextBlock Grid.Column="7" Text="{Binding Borrower}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Panneau de détail -->
      <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <Panel>
          <TextBlock IsVisible="{Binding !HasDetail}" Opacity="0.6" TextWrapping="Wrap"
                     Text="Sélectionnez un titre pour voir sa fiche. Sélection multiple : Ctrl+clic ou Maj+clic." />
          <ScrollViewer IsVisible="{Binding HasDetail}">
            <StackPanel Spacing="16">
            <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=400}"
                   MaxHeight="420" HorizontalAlignment="Left" Stretch="Uniform"
                   IsVisible="{Binding PosterPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Spacing="6" DataContext="{Binding Detail}" x:DataType="titles:TitleDetail">
              <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding OriginalTitle}" Opacity="0.7" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Tagline}" FontStyle="Italic" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Year}" />
                <TextBlock Text="{Binding RuntimeMinutes, StringFormat='{}{0} min'}" />
                <TextBlock Text="{Binding Certification}" />
              </StackPanel>
              <TextBlock Text="{Binding UserRating, StringFormat='Ma note : {0}/10'}" />
              <TextBlock Text="{Binding TmdbRating, StringFormat='TMDb : {0:0.0}/10'}" Opacity="0.8" />
              <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Margin="0,8,0,8" />
              <TextBlock Text="{Binding Copy.MediumCode, StringFormat='Support : {0}'}" Opacity="0.8" />
              <TextBlock Text="{Binding Copy.Location, StringFormat='Emplacement : {0}'}" Opacity="0.8" />
              <TextBlock Text="{Binding ViewCount, StringFormat='Vu {0} fois'}" Opacity="0.8" />
              <TextBlock Text="{Binding CollectionName, StringFormat='Collection : {0}'}" Opacity="0.8" IsVisible="{Binding CollectionName, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"><TextBlock Text="{Binding}" FontSize="12" /></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Comments}" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <!-- Fichiers -->
            <StackPanel Spacing="4" IsVisible="{Binding DetailFilesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="Fichiers" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding DetailFilesText}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            </StackPanel>

            <!-- Prêt -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="Prêt" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail.CurrentLoan.Borrower, StringFormat='Prêté à {0}'}" IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Detail.CurrentLoan.LoanedAt, StringFormat='depuis le {0:d}'}" Opacity="0.7" IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNull}}">
                  <TextBox Width="180" PlaceholderText="Emprunteur" Text="{Binding BorrowerText}" />
                  <Button Content="Prêter" Command="{Binding LendCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Rendu" Command="{Binding ReturnLoanCommand}" />
                  <Button Content="Historique" Command="{Binding ShowLoanHistoryCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
