<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:people="using:Cinedex.Core.People"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.PeopleWindow"
        x:DataType="vm:PeopleBrowserViewModel"
        Title="{Binding WindowTitle}"
        Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <Border DockPanel.Dock="Top" Classes="card" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Inline3}" Margin="{StaticResource Below3}">
      <DockPanel>
        <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}" BorderThickness="0" Background="Transparent" Margin="{StaticResource Before1}" />
      </DockPanel>
    </Border>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="{StaticResource Above3}">
      <StackPanel Spacing="{StaticResource Space1}">
        <Button Classes="tool" HorizontalAlignment="Left" Command="{Binding DownloadDetailsCommand}"
                ToolTip.Tip="Biographie, dates et photo depuis TMDb pour les personnes listées qui ne les ont pas encore">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="cloud" Width="16" Height="16" /><TextBlock Text="Télécharger les fiches manquantes" /></StackPanel>
        </Button>
        <TextBlock Text="{Binding Message}" Classes="muted" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Bottom">
        <Button Classes="tool" Content="Interrompre" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
    <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding Selected}" Tapped="OnPersonChosen">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="people:PersonSummary">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource Inset1}">
            <Border Width="40" Height="40" CornerRadius="{StaticResource RoundAvatar}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
              <Panel>
                <controls:Icon Kind="person" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="{StaticResource Inline3}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
