<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:data="using:Cinedex.Data"
        x:Class="Cinedex.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Réglages"
        Width="820" Height="680" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,16,0"
                   Text="Les réglages d'import, d'affichage et de métadonnées sont propres au catalogue ouvert ; l'apparence vaut pour tous." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
          <Button Classes="accent" Content="Enregistrer" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <TabControl x:Name="Tabs" TabStripPlacement="Left">
      <!-- Général -->
      <TabItem Header="Général">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="Apparence" Margin="0" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanChooseTheme}">
              <TextBlock Text="Thème" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" MinWidth="200" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanChooseTheme}">
              <TextBlock Text="Langue de l'interface" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" MinWidth="220" />
              <TextBlock Text="(au redémarrage)" VerticalAlignment="Center" Opacity="0.65" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanChooseTheme}">
              <TextBlock Text="Fenêtre au démarrage" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding StartupChoices}" SelectedItem="{Binding SelectedStartup}" MinWidth="300" />
            </StackPanel>
            <TextBlock Classes="hint" Text="F11 bascule à tout moment entre plein écran et fenêtre." />
            <TextBlock Classes="h" Text="Contenu" />
            <CheckBox Content="Masquer les titres marqués « contenu pour adultes » dans la liste" IsChecked="{Binding HideAdult}" />
            <CheckBox Content="Infobulle au survol d'un film : titre, genres, note IMDb et synopsis" IsChecked="{Binding ShowTooltips}" />
            <TextBlock Classes="h" Text="Collections" />
            <CheckBox Content="Gérer les collections (sagas TMDb)" IsChecked="{Binding ManageCollections}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Ajoute le lien « Collections » au bandeau gauche et télécharge depuis TMDb la présentation, la liste des films, l'affiche et le décor de chaque saga, après chaque import. Les films manquants de vos sagas y sont signalés." />
            <TextBlock Classes="h" Text="Données" />
            <TextBlock Text="Catalogues, images, sauvegardes et journaux sont rangés dans :" />
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="{Binding DataLocation}" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
              <Button Grid.Column="1" Classes="tool" Content="Ouvrir le dossier" Click="OnOpenData" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Classes="h" Text="Journal des actions" />
            <CheckBox Content="Noter dans un journal chaque action faite dans Cinedex (un fichier par jour, conservé 90 jours)" IsChecked="{Binding JournalEnabled}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="tool" Content="Exporter le journal du jour…" Click="OnExportJournal" />
              <Button Classes="tool" Content="Ouvrir le dossier des journaux" Click="OnOpenJournalFolder" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding JournalMessage}" IsVisible="{Binding JournalMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="hint" Text="Une sauvegarde de la base est faite automatiquement avant chaque mise à jour de son format. Les clés d'API ne sont jamais écrites dans ce dossier : elles sont dans le coffre du système." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Économiseur d'écran -->
      <TabItem Header="Économiseur d'écran">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="Diaporama des affiches" Margin="0" />
            <CheckBox Content="Afficher un diaporama des affiches après une période d'inactivité" IsChecked="{Binding ScreenSaverEnabled}" />
            <StackPanel Spacing="10" IsEnabled="{Binding ScreenSaverEnabled}">
              <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                <TextBlock Text="Lancer après" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding ScreenSaverIdleMinutes}" Minimum="1" Maximum="240" Increment="1" Width="120" FormatString="0" />
                <TextBlock Grid.Column="2" Text="minutes sans utiliser le clavier ni la souris" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Changer d'affiche toutes les" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ScreenSaverIntervalSeconds}" Minimum="2" Maximum="300" Increment="1" Width="120" FormatString="0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="secondes par affiche" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
              <CheckBox Content="Montrer le titre et l'année sous les affiches" IsChecked="{Binding ScreenSaverShowTitles}" />
            </StackPanel>
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Le diaporama ne se lance que si la fenêtre de Cinedex est active (au premier plan). Une touche, un clic ou un mouvement de souris le ferme. Seuls les films qui ont une affiche y figurent." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Bandeau gauche -->
      <TabItem Header="Bandeau gauche">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="Vues affichées" Margin="0" />
            <TextBlock Classes="hint" Text="« Tous les titres » est toujours affiché. Une vue masquée reste accessible par la recherche multicritère." />
            <ItemsControl ItemsSource="{Binding MainFilterToggles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterToggle">
                  <CheckBox Width="230" Content="{Binding Label}" IsChecked="{Binding IsShown}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Sous-menu Définition" />
            <TextBlock Classes="hint" Text="Si toutes ces vues sont masquées, le sous-menu disparaît." />
            <ItemsControl ItemsSource="{Binding DefinitionFilterToggles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterToggle">
                  <CheckBox Width="230" Content="{Binding Label}" IsChecked="{Binding IsShown}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Liens" />
            <CheckBox Content="Recherche multicritère" IsChecked="{Binding ShowRuleSearch}" />
            <CheckBox Content="Acteurs" IsChecked="{Binding ShowPeople}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Import et scan -->
      <TabItem Header="Import et scan">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="Fichiers retenus" Margin="0" />
            <TextBlock Text="Extensions des fichiers vidéo (séparées par des espaces)" />
            <TextBox Text="{Binding ExtensionsText}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
            <Button Classes="tool" Content="Rétablir les extensions par défaut" Click="OnResetExtensions" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Taille minimale d'un fichier trouvé dans un dossier" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding MinimumMegabytes}" Minimum="0" Maximum="100000" Increment="10" Width="130" FormatString="0" />
              <TextBlock Text="Mo" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="hint" Text="Écarte les extraits et bandes-annonces. Un fichier choisi un par un est toujours proposé." />
            <TextBlock Text="Fichiers ignorés s'ils contiennent l'un de ces mots (un par ligne)" Margin="0,6,0,0" />
            <TextBox Text="{Binding IgnoreKeywordsText}" AcceptsReturn="True" Height="90" FontFamily="Consolas,Menlo,monospace" />
            <CheckBox Content="Parcourir aussi les sous-dossiers" IsChecked="{Binding Recursive}" />

            <TextBlock Classes="h" Text="Lecture du nom de fichier" />
            <CheckBox Content="Ignorer le contenu entre ( ) et [ ] (l'année y est tout de même lue)" IsChecked="{Binding IgnoreBracketed}" />
            <TextBlock Text="Termes retirés des titres (un par ligne, mots entiers, majuscules indifférentes)" />
            <TextBox Text="{Binding NoiseWordsText}" AcceptsReturn="True" TextWrapping="NoWrap" Height="160" FontFamily="Consolas,Menlo,monospace" />
            <Button Classes="tool" Content="Rétablir la liste par défaut" Click="OnResetNoiseWords" />

            <TextBlock Classes="h" Text="Options cochées par défaut à l'import" />
            <CheckBox Content="Rechercher la fiche sur TMDb pendant l'import" IsChecked="{Binding DefaultUseTmdb}" />
            <CheckBox Content="Lire les infos techniques avec MediaInfo" IsChecked="{Binding DefaultReadProperties}" />
            <CheckBox Content="Créer ou compléter le .nfo" IsChecked="{Binding DefaultWriteNfo}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Métadonnées -->
      <TabItem Header="Métadonnées">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="TMDb" Margin="0" />
            <TextBlock Text="{Binding TokenState}" TextWrapping="Wrap" Opacity="0.8" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewToken}" PasswordChar="•" PlaceholderText="Jeton d'accès en lecture (eyJ...)" />
              <Button Grid.Column="1" Classes="tool" Margin="8,0,0,0" Content="Oublier le jeton" Click="OnForget" IsVisible="{Binding HasToken}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,120,24,Auto,80">
              <TextBlock Grid.Column="0" Text="Langue" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding Language}" PlaceholderText="fr-FR" />
              <TextBlock Grid.Column="3" Text="Pays des certifications" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="4" Text="{Binding Country}" PlaceholderText="FR" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Acteurs gardés dans la distribution d'un film" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding MaxActorsNumber}" Minimum="1" Maximum="200" Increment="5" Width="130" FormatString="0" />
            </StackPanel>
            <TextBlock Classes="hint" Text="Appliqué aux prochains imports et mises à jour TMDb. Pour les films déjà au catalogue, relancez « Mettre à jour via TMDb »." />

            <TextBlock Classes="h" Text="Notes IMDb, Rotten Tomatoes, Metacritic" />
            <TextBlock Text="{Binding OmdbState}" TextWrapping="Wrap" Opacity="0.8" />
            <TextBox Text="{Binding NewOmdbKey}" PasswordChar="•" PlaceholderText="Clé API OMDb" />
            <CheckBox Content="Compléter la note IMDb avec le fichier officiel IMDb (téléchargé au plus une fois par jour, ~9 Mo)" IsChecked="{Binding UseImdbDataset}" />
            <TextBlock Classes="hint" Margin="0,8,0,0"
                       Text="Cinedex utilise l'API TMDb. This product uses the TMDB API but is not endorsed or certified by TMDB. IMDb n'est utilisé que pour les identifiants, les liens et son fichier public de notes." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- .nfo -->
      <TabItem Header="Fichiers .nfo">
        <StackPanel Spacing="10" Margin="12,0,0,0">
          <TextBlock Classes="h" Text="Fichiers .nfo (format Kodi)" Margin="0" />
          <CheckBox Content="Lire le .nfo au scan d'un dossier et compléter la fiche" IsChecked="{Binding NfoReadOnScan}" />
          <CheckBox Content="Créer ou compléter le .nfo après une mise à jour TMDb" IsChecked="{Binding NfoWriteAfterMetadata}" />
          <CheckBox Content="Remplacer les valeurs déjà présentes dans le .nfo (sinon seuls les champs manquants sont ajoutés)" IsChecked="{Binding NfoOverwrite}" />
          <CheckBox Content="Garder une copie .nfo.bak du fichier d'origine avant modification" IsChecked="{Binding NfoBackup}" />
        </StackPanel>
      </TabItem>

      <!-- Lecture et outils -->
      <TabItem Header="Lecture et outils">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="12,0,0,0">
            <TextBlock Classes="h" Text="Infos techniques" Margin="0" />
            <TextBox Text="{Binding MediaInfoPath}" PlaceholderText="Chemin de MediaInfo CLI (vide : MediaInfo fourni avec Cinedex, puis PATH)" />
            <TextBox Text="{Binding FfprobePath}" PlaceholderText="Repli : chemin de ffprobe (facultatif)" />
            <TextBlock Classes="h" Text="Lecture" />
            <TextBox Text="{Binding PlayerPath}" PlaceholderText="Lecteur externe (vide : lecteur par défaut du système)" />
            <TextBox Text="{Binding PlayerArgs}" PlaceholderText="Paramètres du lecteur, ex. --fullscreen %FILEPATH%" />
            <CheckBox Content="Marquer comme vu à la lecture depuis Cinedex" IsChecked="{Binding MarkSeenOnPlay}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Statistiques du catalogue ouvert -->
      <TabItem Header="Statistiques" IsVisible="{Binding HasStatistics}">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="12,0,0,0">
            <ItemsControl ItemsSource="{Binding StatCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatCard">
                  <Border Width="150" Margin="0,0,10,10" Padding="12,10" CornerRadius="10" Background="{DynamicResource CinedexSurfaceAlt}"
                          BorderBrush="{DynamicResource CinedexBorder}" BorderThickness="1">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" />
                      <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Par genre" />
            <ItemsControl ItemsSource="{Binding Statistics.Genres}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:StatCount">
                  <Grid ColumnDefinitions="200,*,60" Margin="0,2">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="10" MinWidth="0" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Par décennie" />
            <ItemsControl ItemsSource="{Binding Statistics.Decades}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:StatCount">
                  <Grid ColumnDefinitions="200,*,60" Margin="0,2">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="10" MinWidth="0" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Par définition" />
            <ItemsControl ItemsSource="{Binding Statistics.Definitions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:StatCount">
                  <Grid ColumnDefinitions="200,*,60" Margin="0,2">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="10" MinWidth="0" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Par support" />
            <ItemsControl ItemsSource="{Binding Statistics.Media}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:StatCount">
                  <Grid ColumnDefinitions="200,*,60" Margin="0,2">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="10" MinWidth="0" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h" Text="Par disque (MediaID)" />
            <ItemsControl ItemsSource="{Binding Statistics.Disks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:StatCount">
                  <Grid ColumnDefinitions="200,*,60" Margin="0,2">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Ratio}" Height="10" MinWidth="0" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
