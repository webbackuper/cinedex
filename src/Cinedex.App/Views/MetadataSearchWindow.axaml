<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        x:Class="Cinedex.App.Views.MetadataSearchWindow"
        x:DataType="vm:MetadataSearchViewModel"
        Title="Rechercher sur TMDb"
        Width="760" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space2}" Margin="{StaticResource Below3}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Heat (1995), tt0113277, movie/949...">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Margin="{StaticResource Before2}" Content="Rechercher" Command="{Binding SearchCommand}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Message}" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="tool" Content="Voir ces propositions sur TMDb ↗" Click="OnOpenSearch"
                ToolTip.Tip="Ouvre la même recherche sur le site TMDb, dans le navigateur" />
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Right" Margin="{StaticResource Above3}">
      <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="{StaticResource FontSmall}" Margin="{StaticResource After4}"
                 Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
      <Button Classes="tool" Content="Annuler" IsCancel="True" Click="OnCancel" />
      <Button Classes="primary" Content="Choisir" IsDefault="True" Click="OnChoose" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" DoubleTapped="OnChoose">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SearchRow">
          <StackPanel Spacing="{StaticResource Space1}" Margin="{StaticResource Block1}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tool" Content="TMDb ↗" Padding="{StaticResource Inset2x1}" Click="OnOpenResult" ToolTip.Tip="Voir cette fiche sur TMDb" />
            </Grid>
            <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="{StaticResource FontSmall}" />
            <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontSmall}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
