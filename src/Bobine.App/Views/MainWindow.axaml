<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        xmlns:titles="using:Bobine.Core.Titles"
        x:Class="Bobine.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Bobine"
        Width="1100" Height="700" MinWidth="640" MinHeight="400">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBox Width="320" PlaceholderText="Rechercher un titre, un synopsis..." Text="{Binding SearchText}" />
      <TextBox Width="320" PlaceholderText="Nouveau titre, ex. Heat (1995)" Text="{Binding NewTitleText}" />
      <Button Content="Ajouter" Command="{Binding AddCommand}" IsDefault="True" />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Status}" Opacity="0.8" />
      <TextBlock Grid.Column="1" Text="{Binding DataLocation}" Opacity="0.6" FontSize="12" />
    </Grid>
    <ListBox ItemsSource="{Binding Titles}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="titles:TitleSummary">
          <Grid ColumnDefinitions="*,80,80">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Year}" />
            <TextBlock Grid.Column="2" Text="{Binding Kind}" Opacity="0.7" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
