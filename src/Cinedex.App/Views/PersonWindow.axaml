<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:people="using:Cinedex.Core.People"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.PersonWindow"
        x:DataType="vm:PersonViewModel"
        Title="{Binding Name}"
        Width="860" Height="640" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="300,*" Margin="{StaticResource Inset6}">
    <!-- Identité -->
    <ScrollViewer Grid.Column="0" Margin="{StaticResource After6}">
      <StackPanel Spacing="{StaticResource Space3}">
        <Border Width="220" Height="300" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}" HorizontalAlignment="Left">
          <Panel>
            <controls:Icon Kind="about" Width="48" Height="48" Foreground="{DynamicResource CinedexMuted}" />
            <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=440}" Stretch="UniformToFill" />
          </Panel>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding KnownFor}" Classes="muted" IsVisible="{Binding KnownFor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Dates}" Classes="muted" TextWrapping="Wrap" FontSize="{StaticResource FontSmall}" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Button Classes="tool" Click="OnOpenTmdb" IsVisible="{Binding TmdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche TMDb">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="TMDb" /></StackPanel>
          </Button>
          <Button Classes="tool" Click="OnOpenImdb" IsVisible="{Binding ImdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche IMDb">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="IMDb" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Text="Chargement de la fiche TMDb..." Classes="muted" IsVisible="{Binding IsLoading}" />
        <SelectableTextBlock Text="{Binding Biography}" TextWrapping="Wrap" LineHeight="20"
                             IsVisible="{Binding Biography, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Ses titres dans le catalogue -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space1}" Margin="{StaticResource Edges1_0_0_3}">
        <TextBlock Text="{Binding Heading}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Count}" Classes="muted" FontSize="{StaticResource FontSmall}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Above3}">
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Titles}" DoubleTapped="OnTitleChosen" Tapped="OnTitleChosen">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="people:PersonCredit">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource Inset1}" ToolTip.Tip="Afficher ce titre dans le catalogue">
              <Border Width="40" Height="60" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                <Panel>
                  <controls:Icon Kind="default" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                  <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=80}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="{StaticResource Inline3}" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}" RenderTransform="rotate(-90deg)" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
