<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:controls="using:Cinedex.App.Controls"
        x:Class="Cinedex.App.Views.SeriesTrackingWindow"
        x:DataType="vm:SeriesTrackingViewModel"
        Title="Suivi des séries"
        Width="1100" Height="740" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="{StaticResource WindowPadding}">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="{StaticResource Above3}">
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource CinedexAccent}" FontWeight="SemiBold" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space2}">
        <Button Classes="tool" Content="Interrompre" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Classes="tool" Content="Fermer" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space2}" Margin="{StaticResource Below3}">
      <StackPanel Spacing="{StaticResource Space1}">
        <TextBlock Text="Suivi des séries" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" Classes="muted" />
      </StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="240" VerticalAlignment="Center"
                AutomationProperties.Name="Séries affichées" />
      <Button Grid.Column="2" Classes="tool" Command="{Binding RefreshFromTmdbCommand}" IsVisible="{Binding CanRefresh}" VerticalAlignment="Center"
              ToolTip.Tip="Relit saisons et épisodes sur TMDb pour les séries en cours : nouveaux épisodes et dates de diffusion">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="sync" Width="16" Height="16" /><TextBlock Text="Actualiser depuis TMDb" /></StackPanel>
      </Button>
    </Grid>

    <Grid ColumnDefinitions="*,16,340">
      <!-- Séries : progression et prochain épisode -->
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DoubleTapped="OnOpenSeries" AutomationProperties.Name="Séries">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackingRow">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource Inset1}" AutomationProperties.Name="{Binding Title}">
              <Border Width="54" Height="80" CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                <Panel>
                  <controls:Icon Kind="tv" Width="22" Height="22" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                  <controls:AsyncImage Path="{Binding PosterPath}" DecodeWidth="108" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="{StaticResource Inline4}" Spacing="{StaticResource Space1}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" />
                  <Border Classes="chip" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Status}" />
                  </Border>
                </StackPanel>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" MinHeight="6" Foreground="{DynamicResource CinedexAccent}"
                             AutomationProperties.Name="{Binding Progress}" />
                <TextBlock Text="{Binding Progress}" Classes="muted" FontSize="{StaticResource FontSmall}" />
                <TextBlock Text="{Binding NextText}" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AiringText}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding AiringText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="tool" VerticalAlignment="Center" IsVisible="{Binding HasNext}"
                      Command="{Binding $parent[Window].((vm:SeriesTrackingViewModel)DataContext).MarkNextSeenCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Marque vu le prochain épisode à regarder">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="check" Width="16" Height="16" /><TextBlock Text="Vu" /></StackPanel>
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Calendrier des diffusions -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space1}" Margin="{StaticResource Edges1_0_0_2}">
          <TextBlock Text="Prochaines diffusions" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" />
          <TextBlock Text="Épisodes annoncés dans les 60 prochains jours" Classes="muted" FontSize="{StaticResource FontSmall}" />
        </StackPanel>
        <Panel>
          <TextBlock Text="Aucune diffusion annoncée. « Actualiser depuis TMDb » récupère les nouvelles dates." Classes="muted" TextWrapping="Wrap" Margin="{StaticResource Inset1}"
                     IsVisible="{Binding !Upcoming.Count}" />
          <ListBox ItemsSource="{Binding Upcoming}" AutomationProperties.Name="Prochaines diffusions">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:UpcomingRow">
                <Grid ColumnDefinitions="90,*" Margin="{StaticResource Inset1}">
                  <TextBlock Text="{Binding Date}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" />
                  <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                    <TextBlock Text="{Binding Series}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Episode}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
