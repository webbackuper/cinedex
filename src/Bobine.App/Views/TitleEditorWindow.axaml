<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bobine.App.ViewModels"
        x:Class="Bobine.App.Views.TitleEditorWindow"
        x:DataType="vm:TitleEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="760" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Annuler" IsCancel="True" Click="OnCancel" />
        <Button Content="Enregistrer" IsDefault="True" Click="OnSave" />
      </StackPanel>
    </StackPanel>

    <TabControl>
      <TabItem Header="Fiche">
        <ScrollViewer>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8">
            <Grid.Styles>
              <Style Selector="Grid > :is(Control)">
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </Grid.Styles>
            <TextBlock Classes="label" Grid.Row="0" Text="Type" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
            <TextBlock Classes="label" Grid.Row="1" Text="Titre" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" />
            <TextBlock Classes="label" Grid.Row="2" Text="Titre original" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OriginalTitle}" />
            <TextBlock Classes="label" Grid.Row="3" Text="Autre titre" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AlternativeTitle}" />
            <TextBlock Classes="label" Grid.Row="4" Text="Année, durée (min)" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="100" Text="{Binding Year}" />
              <TextBox Width="100" Text="{Binding Runtime}" />
            </StackPanel>
            <TextBlock Classes="label" Grid.Row="5" Text="Accroche" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Tagline}" />
            <TextBlock Classes="label" Grid.Row="6" Text="Synopsis" VerticalAlignment="Top" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Overview}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
            <TextBlock Classes="label" Grid.Row="7" Text="Certification" />
            <TextBox Grid.Row="7" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding Certification}" />
            <TextBlock Classes="label" Grid.Row="8" Text="Pays" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Countries}" PlaceholderText="FR, US" />
            <TextBlock Classes="label" Grid.Row="9" Text="Studio" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Studio}" />
            <TextBlock Classes="label" Grid.Row="10" Text="Identifiant IMDb" />
            <TextBox Grid.Row="10" Grid.Column="1" Width="160" HorizontalAlignment="Left" Text="{Binding ImdbId}" PlaceholderText="tt1234567" />
            <TextBlock Classes="label" Grid.Row="11" Text="Lien web" />
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding WebLink}" PlaceholderText="https://" />
            <TextBlock Classes="label" Grid.Row="12" Text="Ma note (0 à 10)" />
            <TextBox Grid.Row="12" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding UserRating}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Exemplaire">
        <ScrollViewer>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,8">
            <Grid.Styles>
              <Style Selector="Grid > :is(Control)">
                <Setter Property="Margin" Value="0,4" />
              </Style>
            </Grid.Styles>
            <TextBlock Classes="label" Grid.Row="0" Text="Numéro" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="100" Text="{Binding Number}" />
              <TextBox Width="160" Text="{Binding CustomNumber}" PlaceholderText="Numéro personnalisé" />
            </StackPanel>
            <TextBlock Classes="label" Grid.Row="1" Text="Support" />
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedium}" />
            <TextBlock Classes="label" Grid.Row="2" Text="Boîtier" />
            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" />
            <TextBlock Classes="label" Grid.Row="3" Text="Version" />
            <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
            <TextBlock Classes="label" Grid.Row="4" Text="Emplacement" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Location}" />
            <TextBlock Classes="label" Grid.Row="5" Text="Nombre de disques" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding DiscCount}" />
            <TextBlock Classes="label" Grid.Row="6" Text="EAN / UPC" />
            <TextBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Ean}" />
            <TextBlock Classes="label" Grid.Row="7" Text="Prix" />
            <TextBox Grid.Row="7" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Price}" />
            <CheckBox Grid.Row="8" Grid.Column="1" Content="3D" IsChecked="{Binding Is3D}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Genres">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Genres}" Margin="0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GenreChoice">
                <CheckBox Width="200" Content="{Binding Genre.Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Statut et notes">
        <StackPanel Spacing="8" Margin="0,8">
          <CheckBox Content="Possédé (décoché : liste de souhaits)" IsChecked="{Binding IsOwned}" />
          <CheckBox Content="Favori" IsChecked="{Binding IsFavorite}" />
          <CheckBox Content="Liste courte" IsChecked="{Binding IsShortlisted}" />
          <CheckBox Content="Verrouillé : ne pas mettre à jour depuis Internet" IsChecked="{Binding IsLocked}" />
          <CheckBox Content="Contenu pour adultes" IsChecked="{Binding IsAdult}" />
          <TextBlock Text="Commentaires" Margin="0,8,0,0" />
          <TextBox Text="{Binding Comments}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
