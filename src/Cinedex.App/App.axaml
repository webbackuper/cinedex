<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Cinedex.App.Controls"
             x:Class="Cinedex.App.App"
             RequestedThemeVariant="Default">
  <!--
    Palette « Cinedex » : sol de pierre neutre, encre presque noire, un seul accent rouge velours (les fauteuils
    et le rideau de la salle) réservé aux données : notes, progression, sélection d'une affiche. Le chrome reste
    neutre : menu sélectionné en pilule grise, bouton principal presque noir. Thème clair et sombre suivent le
    réglage du système ; l'accent et la couleur des menus se choisissent dans Réglages > Apparence.

    Jetons partagés (tailles, rayons, espacements) : Styles/Tokens.axaml.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- Tailles, rayons, espacements et couleurs d'exception : Styles/Tokens.axaml, seule source des valeurs. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Cinedex/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CinedexBackground" Color="#F7F7F5" />
          <SolidColorBrush x:Key="CinedexSidebar" Color="#F7F7F5" />
          <SolidColorBrush x:Key="CinedexSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CinedexSurfaceAlt" Color="#F1F1EE" />
          <SolidColorBrush x:Key="CinedexBorder" Color="#E6E6E3" />
          <SolidColorBrush x:Key="CinedexInk" Color="#161616" />
          <SolidColorBrush x:Key="CinedexMuted" Color="#5F6066" />
          <SolidColorBrush x:Key="CinedexAccent" Color="#9B1C2E" />
          <SolidColorBrush x:Key="CinedexAccentSoft" Color="#F6E6E8" />
          <SolidColorBrush x:Key="CinedexHover" Color="#EEEEEB" />
          <SolidColorBrush x:Key="CinedexActive" Color="#E8E8E5" />
          <SolidColorBrush x:Key="CinedexPrimary" Color="#1D1F20" />
          <SolidColorBrush x:Key="CinedexOnPrimary" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CinedexNegative" Color="#C4242A" />
          <SolidColorBrush x:Key="CinedexPosterBack" Color="#E9E9E6" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#161616" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CinedexBackground" Color="#121212" />
          <SolidColorBrush x:Key="CinedexSidebar" Color="#121212" />
          <SolidColorBrush x:Key="CinedexSurface" Color="#1B1B1B" />
          <SolidColorBrush x:Key="CinedexSurfaceAlt" Color="#202020" />
          <SolidColorBrush x:Key="CinedexBorder" Color="#2E2E2E" />
          <SolidColorBrush x:Key="CinedexInk" Color="#F2F2F2" />
          <SolidColorBrush x:Key="CinedexMuted" Color="#ABABAB" />
          <SolidColorBrush x:Key="CinedexAccent" Color="#E2707F" />
          <SolidColorBrush x:Key="CinedexAccentSoft" Color="#3A1F24" />
          <SolidColorBrush x:Key="CinedexHover" Color="#232323" />
          <SolidColorBrush x:Key="CinedexActive" Color="#2A2A2A" />
          <SolidColorBrush x:Key="CinedexPrimary" Color="#F2F2F2" />
          <SolidColorBrush x:Key="CinedexOnPrimary" Color="#111111" />
          <SolidColorBrush x:Key="CinedexNegative" Color="#E5566F" />
          <SolidColorBrush x:Key="CinedexPosterBack" Color="#242424" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#F2F2F2" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Police de l'interface (Réglages > Apparence) ; remplacée au lancement selon le choix enregistré. -->
      <FontFamily x:Key="CinedexFont">fonts:Inter#Inter</FontFamily>

    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#9B1C2E" RegionColor="#F7F7F5" />
        <ColorPaletteResources x:Key="Dark" Accent="#E2707F" RegionColor="#121212" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Toutes les fenêtres (fiche, réglages, import, recherche...) partagent le fond « papier » et l'encre. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource CinedexBackground}" />
      <Setter Property="Icon" Value="/Assets/cinedex.ico" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
      <Setter Property="FontFamily" Value="{DynamicResource CinedexFont}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Élément choisi d'une liste : la pilule grise du menu, partout (jamais l'accent sur le chrome). -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexHover}" />
    </Style>

    <!-- Bouton plat à icône, utilisé partout dans les barres d'outils. -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Inset2}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexHover}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Action destructive (purge) : libellé dans la couleur d'accent pour qu'on ne la confonde pas avec les autres. -->
    <Style Selector="Button.tool.danger">
      <Setter Property="Foreground" Value="{DynamicResource CinedexAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Bouton secondaire : contour d'un pas plus fort que les bordures, fond transparent. -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource CinedexBorder}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="{StaticResource Inset3x2}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexHover}" />
    </Style>
    <!-- Bouton principal : un seul par écran, presque noir (blanc en thème sombre). -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource CinedexPrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexOnPrimary}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="{StaticResource Inset3x2}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexPrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexOnPrimary}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.primary controls|Icon">
      <Setter Property="Foreground" Value="{DynamicResource CinedexOnPrimary}" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Inset2}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <!-- Bascule active (liste / affiches) : la même pilule grise que le menu, sans couleur d'accent. -->
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked controls|Icon">
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource CinedexMuted}" />
    </Style>
    <!-- Libellé de groupe du bandeau : casse normale, gris, sans espacement des lettres. -->
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource CinedexMuted}" />
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="Margin" Value="{StaticResource Edges4_6_0_2}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CinedexSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CinedexBorder}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    </Style>
    <!-- Pastille (genre, tag, statut) : fond pâle neutre, encre ; jamais d'accent saturé. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
      <Setter Property="Padding" Value="{StaticResource Inset2x1}" />
      <Setter Property="Margin" Value="{StaticResource Trail2}" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource CinedexInk}" />
    </Style>
  </Application.Styles>
</Application>
