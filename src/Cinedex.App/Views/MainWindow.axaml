<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinedex.App.ViewModels"
        xmlns:titles="using:Cinedex.Core.Titles"
        xmlns:views="using:Cinedex.App.Views"
        xmlns:controls="using:Cinedex.App.Controls"
        xmlns:people="using:Cinedex.Core.People"
        xmlns:services="using:Cinedex.App.Services"
        xmlns:data="using:Cinedex.Data"
        x:Class="Cinedex.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cinedex"
        Width="1360" Height="820" MinWidth="960" MinHeight="560"
        Background="{DynamicResource CinedexBackground}"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding ToggleSeenCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleFavoriteCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding PickRandomCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding PickRandomCommand}" />
    <KeyBinding Gesture="Alt+E" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding AdvancedSearchCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding AddFromTmdbCommand}" />
    <KeyBinding Gesture="Ctrl+U" Command="{Binding LinkToTmdbCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+U" Command="{Binding UpdateAllFromTmdbCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ImportFolderCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowListCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding ShowGridCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding ToggleDetailCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Barre latérale : entrées plates de 34 px, sélection en pilule grise, libellé inchangé. -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="{StaticResource Inline3}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="{StaticResource Inline2}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <!-- Acteurs ou réalisateurs affichés : leur lien porte la pilule, plus le filtre de la bibliothèque. -->
    <Style Selector="ListBox.nav.away ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool.current /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <!-- Liste et grille de titres. -->
    <Style Selector="ListBox.titles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.titles ListBoxItem">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
      <Setter Property="Margin" Value="{StaticResource Block1}" />
      <Setter Property="Padding" Value="{StaticResource Inset3x2}" />
    </Style>
    <Style Selector="ListBox.titles ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <!-- Pastille de sélection d'une affiche : croix dans un rond, visible quand la carte est sélectionnée. -->
    <Style Selector="Button.selbadge">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="{StaticResource RoundBadge}" />
      <Setter Property="Background" Value="{DynamicResource CinedexAccent}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|PosterCard:selected Button.selbadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.selbadge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CinedexAccent}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.rating">
      <Setter Property="Background" Value="{DynamicResource CinedexSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CinedexBorder}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="{StaticResource Inset2x1}" />
      <Setter Property="Margin" Value="{StaticResource Trail2}" />
    </Style>
    <Style Selector="controls|PosterCard.poster:pointerover">
      <Setter Property="Background" Value="{DynamicResource CinedexHover}" />
    </Style>
    <Style Selector="controls|PosterCard.poster:selected">
      <Setter Property="Background" Value="{DynamicResource CinedexActive}" />
    </Style>
    <!-- Poignée de la fiche : invisible au repos, trait gris au survol et pendant le glissement. -->
    <Style Selector="GridSplitter.detail">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="{TemplateBinding Background}">
            <Border Name="PART_Line" Width="2" CornerRadius="{StaticResource RadiusChip}" Margin="{StaticResource Block6}" Background="Transparent" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.detail:pointerover /template/ Border#PART_Line, GridSplitter.detail:pressed /template/ Border#PART_Line, GridSplitter.detail:focus-visible /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource CinedexBorder}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="MainGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="Auto" />
      <!-- Fiche : largeur réglée par la poignée (300 à 760 px), mémorisée pour le catalogue. -->
      <ColumnDefinition Width="372" MinWidth="300" MaxWidth="760" />
    </Grid.ColumnDefinitions>
    <!-- ======================= Barre latérale ======================= -->
    <Border Grid.Column="0" Background="{DynamicResource CinedexSidebar}" BorderBrush="{DynamicResource CinedexBorder}" BorderThickness="{StaticResource HairlineEnd}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Edges6_6_4_2}" Spacing="{StaticResource Space1}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
            <Image Source="/Assets/cinedex.png" Width="30" Height="30" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Cinedex" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="tool" Margin="-8,8,0,0" Command="{Binding ManageCatalogsCommand}" ToolTip.Tip="Ouvrir, créer, renommer ou retirer un catalogue">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <controls:Icon Kind="database" Width="18" Height="18" />
              <TextBlock Text="{Binding CatalogName}" FontSize="{StaticResource FontSmall}" />
              <controls:Icon Kind="chevron-down" Width="14" Height="14" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource Edges2_2_2_4}" Spacing="{StaticResource Space1}">
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenReviewCommand}"
                  IsVisible="{Binding HasReviews}" ToolTip.Tip="Titres pour lesquels plusieurs fiches TMDb sont possibles : choisissez la bonne">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="alert" Width="18" Height="18" Foreground="{DynamicResource CinedexAccent}" />
              <TextBlock Text="{Binding ReviewLabel}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding AdvancedSearchCommand}" IsVisible="{Binding ShowRuleSearch}"
                  ToolTip.Tip="Chercher sur tous les champs : genre, notes, année, acteurs, MediaID… (Ctrl+Maj+F)">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="funnel" Width="18" Height="18" />
              <TextBlock Text="Recherche multicritère" />
            </StackPanel>
          </Button>
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding HasUpdate}"
                  ToolTip.Tip="Télécharge la nouvelle version et redémarre Cinedex dessus">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="cloud" Width="18" Height="18" />
              <TextBlock Text="{Binding UpdateLabel}" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenPeopleCommand}" IsVisible="{Binding ShowPeopleLink}" Classes.current="{Binding IsActorsView}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="person" Width="18" Height="18" />
              <TextBlock Text="Acteurs" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenDirectorsCommand}" IsVisible="{Binding ShowDirectorsLink}" Classes.current="{Binding IsDirectorsView}"
                  ToolTip.Tip="Réalisateurs du catalogue : fiche, biographie et films réalisés">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="clapper" Width="18" Height="18" />
              <TextBlock Text="Réalisateurs" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenSeriesTrackingCommand}" IsVisible="{Binding HasSeries}"
                  ToolTip.Tip="Épisodes à regarder et prochaines diffusions de vos séries">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="tv" Width="18" Height="18" />
              <TextBlock Text="{Binding SeriesTrackingLabel}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenCollectionsCommand}" IsVisible="{Binding ShowCollections}"
                  ToolTip.Tip="Sagas et coffrets : films possédés, films manquants, décors TMDb">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="collection" Width="18" Height="18" />
              <TextBlock Text="Collections" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="Mode clair, sombre ou comme le système">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="moon" Width="18" Height="18" />
              <TextBlock Text="Apparence" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="RightEdgeAlignedBottom">
                <MenuItem Header="Comme le système" ToggleType="Radio" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}" />
                <MenuItem Header="Mode clair" ToggleType="Radio" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}" />
                <MenuItem Header="Mode sombre" ToggleType="Radio" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="options" Width="18" Height="18" />
              <TextBlock Text="Réglages" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding OpenHelpCommand}" ToolTip.Tip="Aide de Cinedex (F1)">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
              <controls:Icon Kind="help" Width="18" Height="18" />
              <TextBlock Text="Aide" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted" FontSize="{StaticResource FontSmall}" Margin="{StaticResource Edges3_2_2_0}" TextWrapping="Wrap" Text="{Binding DataLocation}" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel>
            <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource Edges2_1_2_0}"
                    Command="{Binding ShowHomeCommand}" IsVisible="{Binding CanShowHome}" Classes.current="{Binding IsHomeView}"
                    ToolTip.Tip="Que regarder ce soir : films disponibles jamais vus, sagas commencées, derniers ajouts">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                <controls:Icon Kind="star" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <TextBlock Text="Accueil" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Classes="section" Text="Bibliothèque" />
            <ListBox Classes="nav" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedMainFilter}" Tapped="OnLibraryTapped" Classes.away="{Binding IsPeopleView}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItem">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                    <controls:Icon Kind="{Binding Value, Converter={x:Static views:FilterIconConverter.Instance}}" Width="18" Height="18"
                                   Foreground="{DynamicResource CinedexMuted}" />
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sous-menu Définition : se déplie au clic, et reste ouvert tant qu'une de ses vues est choisie. -->
            <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource Edges2_1_2_0}"
                    Command="{Binding ToggleDefinitionsCommand}" IsVisible="{Binding HasDefinitionFilters}" ToolTip.Tip="Classer par définition de l'image">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:Icon Kind="view" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <TextBlock Grid.Column="1" Margin="{StaticResource Before3}" Text="Définition" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}"
                               RenderTransformOrigin="50%,50%" RenderTransform="{Binding IsDefinitionExpanded, Converter={x:Static views:ExpandArrowConverter.Instance}}" />
              </Grid>
            </Button>
            <ListBox Classes="nav" Margin="{StaticResource Before6}" ItemsSource="{Binding DefinitionFilters}" SelectedItem="{Binding SelectedDefinitionFilter}" Tapped="OnLibraryTapped" Classes.away="{Binding IsPeopleView}"
                     IsVisible="{Binding IsDefinitionExpanded}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterItem">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                    <controls:Icon Kind="{Binding Value, Converter={x:Static views:FilterIconConverter.Instance}}" Width="18" Height="18"
                                   Foreground="{DynamicResource CinedexMuted}" />
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sous-menu MediaID : un disque par ligne, avec le nombre de titres qu'il porte. -->
            <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource Edges2_1_2_0}"
                    Command="{Binding ToggleMediaIdsCommand}" IsVisible="{Binding HasMediaIds}" ToolTip.Tip="Voir les films disque par disque (MediaID)">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:Icon Kind="harddisk" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <TextBlock Grid.Column="1" Margin="{StaticResource Before3}" Text="MediaID" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}"
                               RenderTransformOrigin="50%,50%" RenderTransform="{Binding IsMediaIdExpanded, Converter={x:Static views:ExpandArrowConverter.Instance}}" />
              </Grid>
            </Button>
            <ListBox Classes="nav" Margin="{StaticResource Before6}" ItemsSource="{Binding MediaIds}" SelectedItem="{Binding SelectedMediaId}"
                     IsVisible="{Binding IsMediaIdExpanded}" AutomationProperties.Name="Disques du catalogue">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                    <controls:Icon Kind="harddisk" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sous-menu Listes : Top 250 et listes de référence, avec ce que le catalogue en possède. -->
            <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource Edges2_1_2_0}"
                    Command="{Binding ToggleListsCommand}" IsVisible="{Binding HasReferenceLists}" ToolTip.Tip="Listes de référence : ce que vous avez, et ce qui manque">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:Icon Kind="bookmark" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                <TextBlock Grid.Column="1" Margin="{StaticResource Before3}" Text="Listes" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}"
                               RenderTransformOrigin="50%,50%" RenderTransform="{Binding IsListExpanded, Converter={x:Static views:ExpandArrowConverter.Instance}}" />
              </Grid>
            </Button>
            <ListBox Classes="nav" Margin="{StaticResource Before6}" ItemsSource="{Binding ReferenceLists}" SelectedItem="{Binding SelectedReferenceList}"
                     IsVisible="{Binding IsListExpanded}" AutomationProperties.Name="Listes de référence">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:ReferenceList">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sous-menus de parcours : genres, décennies, pays, langues. Même comportement que MediaID. -->
            <ItemsControl ItemsSource="{Binding Facets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FacetGroup">
                  <StackPanel>
                    <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="{StaticResource Edges2_1_2_0}"
                            Command="{Binding ToggleCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:Icon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
                        <TextBlock Grid.Column="1" Margin="{StaticResource Before3}" Text="{Binding Label}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                        <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}"
                                       RenderTransformOrigin="50%,50%" RenderTransform="{Binding IsExpanded, Converter={x:Static views:ExpandArrowConverter.Instance}}" />
                      </Grid>
                    </Button>
                    <ListBox Classes="nav" Margin="{StaticResource Before6}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             IsVisible="{Binding IsExpanded}" AutomationProperties.Name="{Binding ListName}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacetItem">
                          <TextBlock Text="{Binding Label}" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ======================= Page d'accueil ======================= -->
    <ScrollViewer Grid.Column="1" Margin="{StaticResource Edges6_4_1_0}" IsVisible="{Binding IsHomeView}">
      <StackPanel DataContext="{Binding Home}" x:DataType="vm:HomeViewModel" Spacing="{StaticResource Space4}" Margin="{StaticResource Below4}">
        <TextBlock Text="{Binding Summary}" Classes="muted" IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding Bands}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HomeBand">
              <StackPanel Spacing="{StaticResource Space2}" Margin="{StaticResource Below4}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontTitle}" Foreground="{DynamicResource CinedexInk}" />
                <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="{StaticResource FontSmall}" />
                <ItemsControl ItemsSource="{Binding Titles}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="titles:TitleSummary">
                      <Button Classes="tool" Width="150" Padding="{StaticResource Inset1x2}" Margin="{StaticResource Trail2}" VerticalContentAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenFromHomeCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding Title}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                          <Border Width="128" Height="190" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                            <Panel>
                              <controls:Icon Kind="film" Width="28" Height="28" Foreground="{DynamicResource CinedexMuted}" />
                              <controls:AsyncImage Path="{Binding PosterPath}" DecodeWidth="256" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Year}" FontSize="{StaticResource FontSmall}" Classes="muted" TextAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Rien à proposer pour l'instant : importez des films, ou marquez-en quelques-uns comme vus."
                   Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasBands}" />
      </StackPanel>
    </ScrollViewer>

    <!-- ======================= Zone centrale ======================= -->
    <DockPanel Grid.Column="1" Margin="{StaticResource Edges6_4_1_0}" IsVisible="{Binding IsTitlesView}">
      <!-- Liste de référence choisie : ce qu'elle dit du catalogue, et de quoi combler les manques. -->
      <Border DockPanel.Dock="Top" Margin="{StaticResource Below3}" Padding="{StaticResource Inset4x3}" CornerRadius="{StaticResource RadiusCard}"
              Background="{DynamicResource CinedexSurfaceAlt}" IsVisible="{Binding HasSelectedList}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="{StaticResource Space1}">
            <TextBlock Text="{Binding SelectedReferenceList.Name}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
            <TextBlock Text="{Binding ListStatusText}" Classes="muted" FontSize="{StaticResource FontSmall}" />
            <TextBlock Text="{Binding SelectedReferenceList.Note}" Classes="muted" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" MaxWidth="620"
                       IsVisible="{Binding SelectedReferenceList.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="outline" VerticalAlignment="Center" Content="Ajouter les manquants à mes souhaits"
                  Command="{Binding AddMissingToWishlistCommand}"
                  ToolTip.Tip="Rapatrie la fiche TMDb de chaque film manquant, le marque non possédé et l'étiquette au nom de la liste." />
        </Grid>
      </Border>

      <!-- Barre d'outils -->
      <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Below3}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="{StaticResource Before3}">
          <!-- Ordre d'une liste personnelle : visible seulement quand une liste est ouverte. -->
          <Button Classes="tool" Command="{Binding MoveUpCommand}" IsVisible="{Binding HasPersonalList}" ToolTip.Tip="Monter dans la liste">
            <controls:Icon Kind="chevron-down" RenderTransformOrigin="50%,50%">
              <controls:Icon.RenderTransform><RotateTransform Angle="180" /></controls:Icon.RenderTransform>
            </controls:Icon>
          </Button>
          <Button Classes="tool" Command="{Binding MoveDownCommand}" IsVisible="{Binding HasPersonalList}" ToolTip.Tip="Descendre dans la liste">
            <controls:Icon Kind="chevron-down" />
          </Button>
          <Button Classes="tool" Command="{Binding PickRandomCommand}" ToolTip.Tip="Un titre non vu au hasard (Ctrl+R)">
            <controls:Icon Kind="random" />
          </Button>
          <Button Classes="tool" ToolTip.Tip="Actions sur la sélection, ou sur tous les titres affichés">
            <controls:Icon Kind="more" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Mettre à jour via TMDb" Command="{Binding UpdateAllFromTmdbCommand}" InputGesture="Ctrl+Shift+U">
                  <MenuItem.Icon><controls:Icon Kind="cloud" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Actualiser les notes IMDb (fichier officiel)" Command="{Binding RefreshImdbRatingsCommand}">
                  <MenuItem.Icon><controls:Icon Kind="star" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Relire les infos techniques (MediaInfo)" Command="{Binding RefreshTechnicalCommand}">
                  <MenuItem.Icon><controls:Icon Kind="view" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Écrire les .nfo" Command="{Binding WriteNfoCommand}"
                          ToolTip.Tip="Crée les .nfo manquants et complète les champs vides des .nfo existants, sans toucher à ce qu'ils contiennent déjà.">
                  <MenuItem.Icon><controls:Icon Kind="document" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mettre à jour les .nfo…" Command="{Binding UpdateNfoCommand}"
                          ToolTip.Tip="Réécrit les .nfo existants depuis les fiches de Cinedex, en remplaçant les valeurs déjà présentes. Aucun .nfo n'est créé : un film qui n'en a pas reste sans. À utiliser après avoir corrigé des fiches.">
                  <MenuItem.Icon><controls:Icon Kind="sync" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Vérifier les fichiers" Command="{Binding CheckFilesCommand}">
                  <MenuItem.Icon><controls:Icon Kind="alert" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exporter la liste affichée…" Command="{Binding ExportListCommand}">
                  <MenuItem.Icon><controls:Icon Kind="export" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rafraîchir (F5)" Command="{Binding ReloadCommand}">
                  <MenuItem.Icon><controls:Icon Kind="sync" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="tool" Command="{Binding ImportFolderCommand}" ToolTip.Tip="Ajouter depuis le disque : analyse un dossier de vidéos (Ctrl+H)">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <controls:Icon Kind="folder-plus" />
              <TextBlock Text="Scanner" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AddButton" Classes="primary" ToolTip.Tip="Ajouter un titre (Alt+A)">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <controls:Icon Kind="add" Width="18" Height="18" />
              <TextBlock Text="Ajouter" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="340" Spacing="{StaticResource Space3}" Margin="{StaticResource Inset1}">
                  <TextBlock Text="Ajouter un titre" FontWeight="SemiBold" />
                  <TextBox x:Name="NewTitleBox" Text="{Binding NewTitleText}" PlaceholderText="Titre, ex. Heat (1995), ou tt0113277">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding AddFromTmdbCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Right">
                    <Button Classes="tool" Command="{Binding AddCommand}" Content="À la main" />
                    <Button Classes="primary" Command="{Binding AddFromTmdbCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                        <controls:Icon Kind="cloud" Width="16" Height="16" />
                        <TextBlock Text="Chercher sur TMDb" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <Button Classes="tool" Command="{Binding AdvancedSearchCommand}" ToolTip.Tip="Recherche multicritère (Ctrl+Maj+F)">
              <controls:Icon Kind="funnel" />
            </Button>
            <Button Classes="tool" Command="{Binding ClearSearchCommand}" ToolTip.Tip="Tout afficher : efface recherche, filtre et critères (Échap)"
                    IsVisible="{Binding HasCriteria}">
              <controls:Icon Kind="close" />
            </Button>
          </StackPanel>
          <Border Classes="card" CornerRadius="{StaticResource RadiusCard}" MinWidth="150" Padding="{StaticResource Inline3}" Margin="{StaticResource After2}">
            <DockPanel>
              <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
              <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Rechercher… (Ctrl+F)"
                       BorderThickness="0" Background="Transparent" Margin="{StaticResource Before1}" />
            </DockPanel>
          </Border>
        </DockPanel>

      </DockPanel>

      <!-- Sous-barre : nombre de titres, tri, vue -->
      <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Edges1_0_0_2}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space1}">
          <TextBlock Classes="muted" Text="Trier par" VerticalAlignment="Center" Margin="{StaticResource After1}" FontSize="{StaticResource FontSmall}" />
        <ComboBox Width="170" MinHeight="30" Padding="{StaticResource Inset3x1}" VerticalAlignment="Center" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" ToolTip.Tip="Trier par" />
        <ToggleButton Classes="tool" IsChecked="{Binding SortDescending}" ToolTip.Tip="Ordre inverse">
          <controls:Icon Kind="sort-direction" />
        </ToggleButton>
        <Border Width="1" Margin="{StaticResource Inset2}" Background="{DynamicResource CinedexBorder}" />
        <ToggleButton Classes="tool" IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding ShowListCommand}" ToolTip.Tip="Liste (Ctrl+1)">
          <controls:Icon Kind="list" />
        </ToggleButton>
        <ToggleButton Classes="tool" IsChecked="{Binding IsGridView, Mode=OneWay}" Command="{Binding ShowGridCommand}" ToolTip.Tip="Affiches (Ctrl+2)">
          <controls:Icon Kind="grid" />
        </ToggleButton>
        <Border Width="1" Margin="{StaticResource Inset2}" Background="{DynamicResource CinedexBorder}" />
        <ToggleButton Classes="tool" IsChecked="{Binding !DetailCollapsed, Mode=OneWay}" Command="{Binding ToggleDetailCommand}"
                      ToolTip.Tip="{Binding DetailToggleTip}" AutomationProperties.Name="{Binding DetailToggleTip}">
          <controls:Icon Kind="columns" />
        </ToggleButton>
        </StackPanel>
        <DockPanel VerticalAlignment="Center">
          <ProgressBar DockPanel.Dock="Left" Width="150" MinWidth="0" Margin="{StaticResource After2}" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"
                       Minimum="0" Maximum="{Binding BusyTotal}" Value="{Binding BusyDone}" IsIndeterminate="{Binding IsBusyIndeterminate}"
                       AutomationProperties.Name="Progression du traitement" />
          <TextBlock Text="{Binding Status}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </DockPanel>

      <!-- Barre d'état -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="{StaticResource Edges1_2_1_3}">
        <TextBlock Grid.Column="1" Classes="muted" FontSize="{StaticResource FontSmall}" Text="Sélection multiple : Ctrl+clic ou Maj+clic" />
      </Grid>

      <Panel>
        <!-- Vue liste -->
        <ListBox Classes="titles" IsVisible="{Binding IsListView}" ItemsSource="{Binding Titles}" SelectedItems="{Binding SelectedTitles}"
                 SelectionMode="Multiple" DoubleTapped="OnListDoubleTapped">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="titles:TitleSummary">
              <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.ServiceEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTooltips}" ToolTip.ShowDelay="500">
                <ToolTip.Tip>
                  <views:TitleToolTip DataContext="{Binding}" />
                </ToolTip.Tip>
                <Border Width="40" Height="60" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Poster}">
                  <Panel>
                    <controls:Icon Kind="default" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                    <controls:AsyncImage Path="{Binding PosterPath}" DecodeWidth="80" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource Inline4}" VerticalAlignment="Center" Spacing="{StaticResource Space1}" MinHeight="36">
                  <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CinedexInk}" />
                  <TextBlock Text="{Binding DisplaySubtitle}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding DisplaySubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" ToolTip.Tip="Prêté"
                              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Loan}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" IsVisible="{Binding IsLoaned}">
                      <controls:Icon Kind="loan" Width="16" Height="16" Foreground="{DynamicResource CinedexMuted}" />
                      <TextBlock Text="{Binding Borrower}" Classes="muted" FontSize="{StaticResource FontSmall}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding ImdbText}" Classes="muted" FontSize="{StaticResource FontSmall}" ToolTip.Tip="Note IMDb"
                             IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Imdb}" />
                  <Panel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.UserRating}">
                    <TextBlock Text="{Binding UserRating, StringFormat='{}{0:0.#}'}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexAccent}"
                               IsVisible="{Binding UserRating, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ma note" />
                  </Panel>
                  <Panel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Favorite}">
                    <controls:Icon Kind="heart" Width="16" Height="16" Foreground="{DynamicResource CinedexAccent}" IsVisible="{Binding IsFavorite}" ToolTip.Tip="Favori" />
                  </Panel>
                  <Panel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Seen}">
                    <controls:Icon Kind="check" Width="16" Height="16" Foreground="{DynamicResource CinedexMuted}" IsVisible="{Binding IsSeen}" ToolTip.Tip="Vu" />
                  </Panel>
                  <TextBlock Text="{Binding Number, StringFormat='n° {0}'}" Classes="muted" FontSize="{StaticResource FontSmall}" MinWidth="40" TextAlignment="Right"
                             IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Columns.Number}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Vue affiches : grille virtualisée (seules les affiches visibles existent, même avec 10 000 titres). -->
        <ScrollViewer x:Name="PosterScroll" IsVisible="{Binding IsGridView}" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                      KeyDown="OnGridKeyDown" AutomationProperties.Name="Affiches des titres">
          <!-- Les affiches s'agrandissent pour occuper toute la largeur : taille recalculée par OnPosterAreaResized. -->
          <ItemsRepeater x:Name="PosterGrid" ItemsSource="{Binding Titles}" Margin="{StaticResource After2}">
            <ItemsRepeater.Resources>
              <x:Double x:Key="PosterCardWidth">172</x:Double>
              <x:Double x:Key="PosterImageHeight">234</x:Double>
            </ItemsRepeater.Resources>
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="172" MinItemHeight="300" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="None" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="titles:TitleSummary">
              <controls:PosterCard Classes="poster" Width="{DynamicResource PosterCardWidth}" Padding="{StaticResource Inset2}" CornerRadius="{StaticResource RadiusCard}" Background="Transparent" Cursor="Hand"
                      PointerPressed="OnPosterPressed" DoubleTapped="OnListDoubleTapped"
                      AutomationProperties.Name="{Binding TitleWithYear}">
                <controls:PosterCard.IsSelected>
                  <MultiBinding Converter="{x:Static views:SelectedIdConverter.Instance}">
                    <Binding Path="Id" />
                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SelectedIdSet" />
                  </MultiBinding>
                </controls:PosterCard.IsSelected>
              <Panel>
              <StackPanel Spacing="{StaticResource Space2}" Background="Transparent" ToolTip.ServiceEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTooltips}" ToolTip.ShowDelay="500">
                <ToolTip.Tip>
                  <views:TitleToolTip DataContext="{Binding}" />
                </ToolTip.Tip>
                <Border Height="{DynamicResource PosterImageHeight}" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                  <Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space2}" Margin="{StaticResource Inset3}">
                      <controls:Icon Kind="default" Width="36" Height="36" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center" Classes="muted" FontSize="{StaticResource FontSmall}" />
                    </StackPanel>
                    <controls:AsyncImage Path="{Binding PosterPath}" DecodeWidth="320" Stretch="UniformToFill" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Inset2}">
                      <Border CornerRadius="{StaticResource RoundBadge}" Padding="{StaticResource Inset1}" Background="{StaticResource BadgeScrimBrush}" IsVisible="{Binding IsFavorite}">
                        <controls:Icon Kind="heart" Width="14" Height="14" Foreground="White" />
                      </Border>
                      <Border CornerRadius="{StaticResource RoundBadge}" Padding="{StaticResource Inset1}" Background="{StaticResource BadgeScrimBrush}" IsVisible="{Binding IsSeen}">
                        <controls:Icon Kind="check" Width="14" Height="14" Foreground="White" />
                      </Border>
                    </StackPanel>
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CinedexInk}" />
                <TextBlock Text="{Binding Year}" Classes="muted" FontSize="{StaticResource FontSmall}" Margin="0,-4,0,0" />
              </StackPanel>
              <!-- Croix dans un rond : le titre est sélectionné ; un clic le retire de la sélection. -->
              <Button Classes="selbadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveFromSelectionCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="Retirer de la sélection" ToolTip.Tip="Sélectionné : un clic le retire de la sélection">
                <controls:Icon Kind="close" Width="11" Height="11" Foreground="White" />
              </Button>
              </Panel>
              </controls:PosterCard>
            </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>

        <!-- Catalogue vide -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space3}" IsVisible="{Binding IsEmpty}">
          <controls:Icon Kind="library" Width="56" Height="56" Foreground="{DynamicResource CinedexMuted}" />
          <TextBlock Text="Aucun titre ici pour l'instant" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource CinedexInk}" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                     Text="Scannez un dossier de films, ajoutez un titre depuis TMDb, ou élargissez le filtre." />
        </StackPanel>
      </Panel>
    </DockPanel>

    <!-- ============ Zone centrale : acteurs ou réalisateurs (liens du bandeau gauche) ============ -->
    <DockPanel Grid.Column="1" Margin="{StaticResource Edges6_4_1_0}" IsVisible="{Binding IsPeopleView}">
      <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Below3}" DataContext="{Binding PeopleBrowser}" x:DataType="vm:PeopleBrowserViewModel">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space2}" Margin="{StaticResource Before3}">
          <Button Classes="tool" Command="{Binding DownloadDetailsCommand}"
                  ToolTip.Tip="Biographie, dates et photo depuis TMDb pour les personnes listées qui ne les ont pas encore">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <controls:Icon Kind="cloud" />
              <TextBlock Text="Télécharger les fiches manquantes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Content="Interrompre" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
          <Button Classes="tool" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTitlesCommand}" ToolTip.Tip="Revenir aux affiches des titres">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
              <controls:Icon Kind="grid" />
              <TextBlock Text="Affiches" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Classes="card" CornerRadius="{StaticResource RadiusCard}" MinWidth="150" Padding="{StaticResource Inline3}">
          <DockPanel>
            <controls:Icon DockPanel.Dock="Left" Kind="search" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" />
            <TextBox x:Name="PeopleQueryBox" Text="{Binding Query}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding WindowTitle}"
                     BorderThickness="0" Background="Transparent" Margin="{StaticResource Before1}" />
          </DockPanel>
        </Border>
      </DockPanel>

      <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Edges1_0_0_2}" DataContext="{Binding PeopleBrowser}" x:DataType="vm:PeopleBrowserViewModel">
        <TextBlock DockPanel.Dock="Left" Text="{Binding WindowTitle}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" Margin="{StaticResource After4}" />
        <TextBlock Text="{Binding Message}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" DockPanel.Dock="Right" />
        <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
      </DockPanel>

      <!-- Galerie virtualisée : photo, nom et nombre de titres ; un clic montre la personne dans le bandeau droit, un double-clic ouvre sa fiche. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="{StaticResource Below4}" AutomationProperties.Name="Personnes du catalogue">
        <ItemsRepeater x:Name="PeopleGrid" ItemsSource="{Binding PeopleBrowser.People}" Margin="{StaticResource After2}">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="140" MinItemHeight="240" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="people:PersonSummary">
              <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="{StaticResource Inset2}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPersonCommand}" CommandParameter="{Binding}"
                      DoubleTapped="OnPersonDoubleTapped" AutomationProperties.Name="{Binding Name}"
                      ToolTip.Tip="Double-clic : fiche complète">
                <Classes.current>
                  <MultiBinding Converter="{x:Static views:SelectedIdConverter.Instance}">
                    <Binding Path="Id" />
                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SelectedPersonIds" />
                  </MultiBinding>
                </Classes.current>
                <StackPanel Spacing="{StaticResource Space1}">
                  <Border Height="172" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                    <Panel>
                      <controls:Icon Kind="person" Width="40" Height="40" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                      <controls:AsyncImage Path="{Binding PhotoPath}" DecodeWidth="280" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CinedexInk}" />
                  <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="{StaticResource FontSmall}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
    </DockPanel>

    <!-- Poignée : glisser pour élargir la fiche, double-clic pour revenir à la largeur par défaut. -->
    <GridSplitter x:Name="DetailSplitter" Grid.Column="2" Classes="detail" ResizeDirection="Columns"
                  DragCompleted="OnDetailSplitterDragCompleted" DoubleTapped="OnDetailSplitterDoubleTapped"
                  AutomationProperties.Name="Largeur de la fiche"
                  ToolTip.Tip="Glisser pour changer la largeur de la fiche ; double-clic : largeur par défaut" />

    <!-- ======================= Fiche ======================= -->
    <!-- Fiche repliée : une bande contre le bord droit, qui ne garde que le bouton pour la rouvrir. -->
    <Border Grid.Column="3" Margin="{StaticResource Edges0_4_4_4}" Classes="card" ClipToBounds="True" IsVisible="{Binding DetailCollapsed}">
      <Button Classes="tool" VerticalAlignment="Top" HorizontalAlignment="Stretch" Padding="{StaticResource Inset1}"
              Command="{Binding ToggleDetailCommand}" ToolTip.Tip="{Binding DetailToggleTip}"
              AutomationProperties.Name="{Binding DetailToggleTip}">
        <controls:Icon Kind="chevron-down" Width="14" Height="14" RenderTransform="rotate(90deg)" Foreground="{DynamicResource CinedexMuted}" />
      </Button>
    </Border>

    <Border Grid.Column="3" Margin="{StaticResource Edges0_4_4_4}" Classes="card" ClipToBounds="True" IsVisible="{Binding !DetailCollapsed}">
      <Panel>
      <Panel IsVisible="{Binding IsTitlesView}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space3}" IsVisible="{Binding ShowDetailHint}" Margin="{StaticResource Inset6}">
          <controls:Icon Kind="default" Width="44" Height="44" Foreground="{DynamicResource CinedexMuted}" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Text="Sélectionnez un titre pour voir sa fiche." />
        </StackPanel>

        <!-- Plusieurs titres sélectionnés : leur nombre et leur liste -->
        <DockPanel IsVisible="{Binding HasMultiSelection}" Margin="{StaticResource Inset6}">
          <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space3}" Margin="{StaticResource Below4}">
            <controls:Icon Kind="check" Width="40" Height="40" Foreground="{DynamicResource CinedexAccent}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SelectionLabel}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="{DynamicResource CinedexInk}" />
            <TextBlock Classes="muted" FontSize="{StaticResource FontSmall}" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Les actions s'appliquent à toute la sélection : modifier, vu, favori, mise à jour via TMDb, supprimer…" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SelectionPreview}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Below2}" Foreground="{DynamicResource CinedexInk}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <ScrollViewer IsVisible="{Binding HasDetail}">
          <StackPanel>
            <!-- Bandeau : image de fond fondue, affiche, titre -->
            <Panel Height="230">
              <Image Source="{Binding BackdropPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=800}" Stretch="UniformToFill" />
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{StaticResource ScrimTop}" />
                    <GradientStop Offset="1" Color="{StaticResource ScrimBottom}" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource Inset6}" VerticalAlignment="Bottom">
                <Border Width="92" Height="138" CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                  <Panel>
                    <controls:Icon Kind="default" Width="28" Height="28" Foreground="{DynamicResource CinedexMuted}" />
                    <Image Source="{Binding PosterPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=200}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource Edges4_0_0_1}" VerticalAlignment="Bottom" Spacing="{StaticResource Space1}" DataContext="{Binding Detail}" x:DataType="titles:TitleDetail">
                  <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxLines="3" />
                  <TextBlock Text="{Binding OriginalTitle}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource OnImageTextBrush}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                    <TextBlock Text="{Binding Year}" Foreground="{StaticResource OnImageTextBrush}" FontSize="{StaticResource FontSmall}" />
                    <TextBlock Text="{Binding RuntimeText}" Foreground="{StaticResource OnImageTextBrush}" FontSize="{StaticResource FontSmall}" />
                    <Border BorderBrush="{StaticResource OnImageLineBrush}" BorderThickness="{StaticResource Hairline}" CornerRadius="{StaticResource RadiusChip}" Padding="{StaticResource Inline1}"
                            IsVisible="{Binding Certification, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Certification}" Foreground="{StaticResource OnImageTextBrush}" FontSize="{StaticResource FontSmall}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Panel>

            <StackPanel Margin="{StaticResource Inset6x4}" Spacing="{StaticResource Space4}">
              <!-- Actions -->
              <WrapPanel>
                <Button Classes="primary" Margin="{StaticResource Trail2}" Command="{Binding PlayCommand}" ToolTip.Tip="Lire (Ctrl+P)">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <controls:Icon Kind="play" Width="18" Height="18" />
                    <TextBlock Text="Lire" />
                  </StackPanel>
                </Button>
                <Button Classes="outline" Margin="{StaticResource Trail2}" Command="{Binding OpenSeriesCommand}" IsVisible="{Binding IsSeries}" ToolTip.Tip="Saisons et épisodes">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <controls:Icon Kind="tv" Width="18" Height="18" />
                    <TextBlock Text="Épisodes" />
                  </StackPanel>
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding PlayTrailerCommand}" ToolTip.Tip="Voir la bande-annonce dans le navigateur">
                  <controls:Icon Kind="trailer" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding ToggleSeenCommand}" ToolTip.Tip="Vu / pas vu (Ctrl+S)">
                  <controls:Icon Kind="eye" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="Favori (Ctrl+D)">
                  <controls:Icon Kind="heart" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding EditCommand}" ToolTip.Tip="Modifier la fiche (Alt+E)">
                  <controls:Icon Kind="edit" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding ClearDetailCommand}"
                        ToolTip.Tip="Vider la fiche : efface le descriptif, les identifiants, les notes des sites, les genres, la distribution et l'affiche. Le titre, vos saisies et les fichiers restent.">
                  <controls:Icon Kind="eraser" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding LinkToTmdbCommand}" ToolTip.Tip="Lier ou mettre à jour depuis TMDb (Ctrl+U)">
                  <controls:Icon Kind="cloud" />
                </Button>
                <Button Classes="tool" Margin="{StaticResource Edges0_0_1_2}" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Ouvrir le dossier du fichier (Ctrl+O)">
                  <controls:Icon Kind="folder" />
                </Button>
                <!-- Action destructrice : à part, en dernier, dans la couleur négative. -->
                <Button Classes="tool" Margin="{StaticResource Edges4_0_0_2}" Command="{Binding DeleteCommand}" ToolTip.Tip="Supprimer du catalogue (Suppr)">
                  <controls:Icon Kind="delete" Foreground="{DynamicResource CinedexNegative}" />
                </Button>
              </WrapPanel>

              <!-- Genres : entre les boutons et les notes -->
              <ItemsControl ItemsSource="{Binding DetailGenres}" IsVisible="{Binding HasDetailGenres}" AutomationProperties.Name="Genres">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="chip"><TextBlock Text="{Binding}" /></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="{StaticResource Space3}" DataContext="{Binding Detail}" x:DataType="titles:TitleDetail">
                <!-- Notes -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding UserRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <controls:Icon Kind="star" Width="18" Height="18" Foreground="{DynamicResource CinedexAccent}" />
                    <TextBlock Text="{Binding UserRating, StringFormat='{}{0:0.#} / 10'}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="ma note" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding TmdbRating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding TmdbRating, StringFormat='{}{0:0.0}'}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="TMDb" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <!-- Notes externes : IMDb, Rotten Tomatoes, Metacritic (via OMDb et le fichier officiel IMDb) -->
                <WrapPanel>
                  <Border Classes="rating" IsVisible="{Binding ImdbRating, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Note IMDb">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                      <Border Background="{StaticResource BrandImdbBrush}" CornerRadius="{StaticResource RadiusChip}" Padding="{StaticResource Inline1}"><TextBlock Text="IMDb" FontWeight="SemiBold" FontSize="{StaticResource FontSmall}" Foreground="Black" /></Border>
                      <TextBlock Text="{Binding ImdbRating, StringFormat='{}{0:0.0}'}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                      <TextBlock Text="{Binding ImdbVotes, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='{}{0:N0} votes'}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center"
                                 IsVisible="{Binding ImdbVotes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="rating" IsVisible="{Binding Tomatometer, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Tomatometer (Rotten Tomatoes)">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                      <Border Background="{StaticResource BrandRottenTomatoesBrush}" CornerRadius="{StaticResource RadiusChip}" Padding="{StaticResource Inline1}"><TextBlock Text="RT" FontWeight="SemiBold" FontSize="{StaticResource FontSmall}" Foreground="White" /></Border>
                      <TextBlock Text="{Binding Tomatometer, StringFormat='{}{0} %'}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="rating" IsVisible="{Binding Metascore, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Metascore (Metacritic)">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                      <Border Background="{StaticResource BrandMetacriticBrush}" CornerRadius="{StaticResource RadiusChip}" Padding="{StaticResource Inline1}"><TextBlock Text="MC" FontWeight="SemiBold" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource BrandMetacriticInkBrush}" /></Border>
                      <TextBlock Text="{Binding Metascore}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                      <TextBlock Text="/ 100" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </WrapPanel>

                <TextBlock Text="{Binding Tagline}" FontStyle="Italic" TextWrapping="Wrap" Classes="muted"
                           IsVisible="{Binding Tagline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource CinedexInk}" />

                <!-- Classement -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding CollectionName, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <controls:Icon Kind="library" Width="16" Height="16" Foreground="{DynamicResource CinedexMuted}" />
                  <TextBlock Text="{Binding CollectionName}" Classes="muted" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="chip"><TextBlock Text="{Binding}" /></Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Comments}" TextWrapping="Wrap" Classes="muted"
                           IsVisible="{Binding Comments, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- Distribution et équipe : chaque personne ouvre sa fiche -->
              <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasDirectors}">
                <TextBlock Text="Réalisation" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                <ItemsControl ItemsSource="{Binding Directors}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="people:CastMember">
                      <Button Classes="tool" Width="104" Padding="{StaticResource Inset1x2}" Margin="{StaticResource Trail1}" VerticalContentAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenPersonCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding Name, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Fiche de {0}'}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                          <Border Width="56" Height="56" CornerRadius="{StaticResource RoundAvatarLarge}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}" HorizontalAlignment="Center">
                            <Panel>
                              <controls:Icon Kind="person" Width="22" Height="22" Foreground="{DynamicResource CinedexMuted}" />
                              <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=112}" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Character}" FontSize="{StaticResource FontSmall}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasCast}">
                <TextBlock Text="Distribution" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                <ItemsControl ItemsSource="{Binding Cast}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="people:CastMember">
                      <Button Classes="tool" Width="104" Padding="{StaticResource Inset1x2}" Margin="{StaticResource Trail1}" VerticalContentAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenPersonCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding Name, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Fiche de {0}'}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                          <Border Width="56" Height="56" CornerRadius="{StaticResource RoundAvatarLarge}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}" HorizontalAlignment="Center">
                            <Panel>
                              <controls:Icon Kind="person" Width="22" Height="22" Foreground="{DynamicResource CinedexMuted}" />
                              <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=112}" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Character}" FontSize="{StaticResource FontSmall}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="{Binding CrewText}" Classes="muted" TextWrapping="Wrap" FontSize="{StaticResource FontSmall}" LineHeight="19"
                         IsVisible="{Binding CrewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- Vous aimerez aussi : films proches du catalogue, avec la raison du rapprochement -->
              <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasSimilar}">
                <TextBlock Text="Vous aimerez aussi" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                <ItemsControl ItemsSource="{Binding Similar}" AutomationProperties.Name="Vous aimerez aussi">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimilarTitle">
                      <Button Classes="tool" Width="104" Padding="{StaticResource Inset1x2}" Margin="{StaticResource Trail1}" VerticalContentAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSimilarCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding Reason}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                          <Border Width="76" Height="112" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}" HorizontalAlignment="Center">
                            <Panel>
                              <controls:Icon Kind="film" Width="22" Height="22" Foreground="{DynamicResource CinedexMuted}" />
                              <controls:AsyncImage Path="{Binding Title.PosterPath}" DecodeWidth="152" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <TextBlock Text="{Binding Title.Title}" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FontSmall}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Suggestions TMDb : surtout des films absents du catalogue, ajoutables à la liste de souhaits -->
              <StackPanel Spacing="{StaticResource Space2}">
                <Button Classes="tool" HorizontalAlignment="Left" Command="{Binding FetchSuggestionsCommand}"
                        ToolTip.Tip="Demande à TMDb ce que les spectateurs de ce film ont aussi aimé. Un seul appel par titre : le résultat est gardé.">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <controls:Icon Kind="cloud" Width="16" Height="16" />
                    <TextBlock Text="Suggestions TMDb" />
                  </StackPanel>
                </Button>
                <StackPanel Spacing="{StaticResource Space1}" IsVisible="{Binding HasTmdbSuggestions}">
                  <ItemsControl ItemsSource="{Binding TmdbSuggestions}" AutomationProperties.Name="Suggestions TMDb">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="data:TmdbSuggestion">
                        <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="{StaticResource Inset1x2}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSuggestionCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <controls:Icon Kind="check" Width="14" Height="14" IsVisible="{Binding IsOwned}" Foreground="{DynamicResource CinedexAccent}" VerticalAlignment="Center" />
                            <controls:Icon Kind="add" Width="14" Height="14" IsVisible="{Binding !IsOwned}" Foreground="{DynamicResource CinedexMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="{StaticResource Before2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Year}" Classes="muted" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="hint" Text="Coché : déjà au catalogue. Sinon, un clic l'ajoute à votre liste de souhaits." TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <!-- Exemplaire et vidéo -->
              <Border Background="{DynamicResource CinedexSurfaceAlt}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Inset4x3}">
                <StackPanel Spacing="{StaticResource Space2}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:Icon Kind="harddisk" Width="16" Height="16" Foreground="{DynamicResource CinedexMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="{StaticResource Before2}" Text="Fichier et infos techniques" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="tool" Content="Relire (MediaInfo)" Command="{Binding RefreshTechnicalCommand}"
                            IsVisible="{Binding HasDetailFiles}" ToolTip.Tip="Relire codecs, résolution, pistes audio et sous-titres" />
                  </Grid>
                  <SelectableTextBlock Text="{Binding TechnicalSummary}" TextWrapping="Wrap" FontSize="{StaticResource FontSmall}" LineHeight="19" Foreground="{DynamicResource CinedexMuted}" />
                </StackPanel>
              </Border>

              <!-- Prêt -->
              <Border Background="{DynamicResource CinedexSurfaceAlt}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource Inset4x3}">
                <StackPanel Spacing="{StaticResource Space2}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <controls:Icon Kind="loan" Width="16" Height="16" Foreground="{DynamicResource CinedexMuted}" />
                    <TextBlock Text="Prêt" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Detail.CurrentLoan.Borrower, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='Prêté à {0}'}" Foreground="{DynamicResource CinedexInk}"
                             IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding Detail.CurrentLoan.LoanedAt, Converter={x:Static views:TrFormatConverter.Instance}, ConverterParameter='depuis le {0:d}'}" Classes="muted"
                             IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Detail.CurrentLoan, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBox PlaceholderText="Emprunteur" Text="{Binding BorrowerText}" />
                    <Button Grid.Column="1" Margin="{StaticResource Before2}" Content="Prêter" Command="{Binding LendCommand}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <Button Classes="tool" Content="Rendu" Command="{Binding ReturnLoanCommand}" />
                    <Button Classes="tool" Content="Historique" Command="{Binding ShowLoanHistoryCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>

      <!-- Personne choisie dans la galerie des acteurs ou des réalisateurs -->
      <Panel IsVisible="{Binding IsPeopleView}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space3}" IsVisible="{Binding !HasPersonPage}" Margin="{StaticResource Inset6}">
          <controls:Icon Kind="person" Width="44" Height="44" Foreground="{DynamicResource CinedexMuted}" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Text="Sélectionnez une personne pour voir sa fiche." />
        </StackPanel>
        <ScrollViewer IsVisible="{Binding HasPersonPage}" AutomationProperties.Name="Fiche de la personne">
          <StackPanel DataContext="{Binding PersonPage}" x:DataType="vm:PersonViewModel" Margin="{StaticResource Inset6}" Spacing="{StaticResource Space4}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}">
              <Border Width="120" Height="180" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                <Panel>
                  <controls:Icon Kind="person" Width="36" Height="36" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                  <Image Source="{Binding PhotoPath, Converter={x:Static views:PathToBitmapConverter.Instance}, ConverterParameter=240}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="{StaticResource Space1}">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding KnownFor}" Classes="muted" IsVisible="{Binding KnownFor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding Dates}" Classes="muted" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" />
                <WrapPanel Margin="{StaticResource Above1}">
                  <Button Classes="tool" Click="OnOpenPersonTmdb" IsVisible="{Binding TmdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche TMDb">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="TMDb" /></StackPanel>
                  </Button>
                  <Button Classes="tool" Click="OnOpenPersonImdb" IsVisible="{Binding ImdbUrl, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Ouvrir la fiche IMDb">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"><controls:Icon Kind="link" Width="16" Height="16" /><TextBlock Text="IMDb" /></StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Grid>
            <TextBlock Text="Chargement de la fiche TMDb..." Classes="muted" IsVisible="{Binding IsLoading}" />
            <SelectableTextBlock Text="{Binding Biography}" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource CinedexInk}"
                                 IsVisible="{Binding Biography, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Spacing="{StaticResource Space1}">
              <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="{DynamicResource CinedexInk}" />
              <TextBlock Text="{Binding Count}" Classes="muted" FontSize="{StaticResource FontSmall}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Titles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="people:PersonCredit">
                  <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource Inset1}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChoosePersonTitleCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title}" ToolTip.Tip="Afficher ce titre dans le catalogue">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="40" Height="60" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{DynamicResource CinedexPosterBack}">
                        <Panel>
                          <controls:Icon Kind="default" Width="18" Height="18" Foreground="{DynamicResource CinedexMuted}" Opacity="0.6" />
                          <controls:AsyncImage Path="{Binding PosterPath}" DecodeWidth="80" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="{StaticResource Inline3}" VerticalAlignment="Center" Spacing="{StaticResource Space1}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CinedexInk}" />
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <controls:Icon Grid.Column="2" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource CinedexMuted}" RenderTransform="rotate(-90deg)" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
      </Panel>
    </Border>
  </Grid>
</Window>
